      {
        "name": "REVREC_Proportional_Delivery",
        "priority": 120,
        "ruleType": "iteration",
        "generatedCode": "## ═══════════════════════════════════════════════════════════════\n## REVREC_PROPORTIONAL_DELIVERY\n## ═══════════════════════════════════════════════════════════════\n\n## Steps\npostingdate = PROF_SERVICE_DELIVERY.postingdate\neffectivedate = PROF_SERVICE_DELIVERY.postingdate\ndelivery_effdate = PROF_SERVICE_DELIVERY.effectivedate\nsubinstrumentid = PROF_SERVICE_DELIVERY.subinstrumentid\nthis_sub = PROF_SERVICE_DELIVERY.subinstrumentid\nunits = PROF_SERVICE_DELIVERY.units_delivered\nconcat_key = concat(instrumentid, this_sub)\npdel_ids = collect_by_instrument('PROF_SERVICE_DELIVERY_service_delivery_id')\npdel_subids = collect_by_instrument('PROF_SERVICE_DELIVERY_subinstrumentid')\npdel_units = collect_by_instrument('PROF_SERVICE_DELIVERY_units_delivered')\npdel_postings = collect_by_instrument('PROF_SERVICE_DELIVERY_postingdate')\npdel_effdates = collect_by_instrument('PROF_SERVICE_DELIVERY_effectivedate')\nline_ends = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_SERVICE_END_DATE_CURRENT')\norder_end = max(line_ends)\nregister_balance = collect_by_instrument(REVENUE_BALANCE.BALANCES_ENDINGBALANCE_TOTAL_REVENUE)\nbal_subids = collect_by_instrument('REVENUE_BALANCE_subinstrumentid')\nbal_amounts = collect_by_instrument('REVENUE_BALANCE_BALANCES_ENDINGBALANCE_TOTAL_REVENUE')\nregister_ssp = collect_all(SSP_RULE.ssp_amount)\nregister_so = collect_by_instrument(SALE_ORDER_DETAILS.ATTRIBUTE_SALE_PRICE_CURRENT)\ncat_product = collect_all('SSP_RULE_product_code')\ncat_policy = collect_all('SSP_RULE_standalone_price_policy')\ncat_ssp_amount = collect_all('SSP_RULE_ssp_amount')\nline_products = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_PRODUCT_ID_CURRENT')\nline_sub_ids = collect_by_instrument('SALE_ORDER_DETAILS_subinstrumentid')\nline_sale_prices = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_SALE_PRICE_CURRENT')\nline_postings = collect_by_instrument('SALE_ORDER_DETAILS_postingdate')\nboarding_month_end = end_of_month(array_get(line_postings, 0, postingdate))\n## Iteration\nline_policies = apply_each(line_products, \"lookup(cat_policy, cat_product, each)\", {\"cat_product\": cat_product, \"cat_policy\": cat_policy, \"line_products\": line_products})\n\n## Iteration\nline_ssp_dollar = apply_each(line_products, \"lookup(cat_ssp_amount, cat_product, each)\", {\"cat_product\": cat_product, \"cat_ssp_amount\": cat_ssp_amount, \"line_products\": line_products})\n\n## Iteration\nline_ssp_amounts = apply_each(line_products, \"if(eq(lookup(line_policies, line_products, each), \\\"DOLLAR_AMOUNT\\\"), lookup(line_ssp_dollar, line_products, each), lookup(line_sale_prices, line_products, each))\", {\"line_products\": line_products, \"line_sale_prices\": line_sale_prices, \"line_policies\": line_policies, \"line_ssp_dollar\": line_ssp_dollar})\n\nline_inv = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_INVOICE_NUMBER_CURRENT')\nline_refinv = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_REFERENCE_INVOICE_NUMBER_CURRENT')\n## Iteration\nline_is_credit = apply_each(line_sub_ids, \"if(neq(lookup(line_inv, line_sub_ids, each), lookup(line_refinv, line_sub_ids, each)), 1, 0)\", {\"line_sub_ids\": line_sub_ids, \"line_inv\": line_inv, \"line_refinv\": line_refinv})\n\n## Iteration\nline_sale_price_nc = apply_each(line_sub_ids, \"multiply(lookup(line_sale_prices, line_sub_ids, each), subtract(1, lookup(line_is_credit, line_sub_ids, each)))\", {\"line_sub_ids\": line_sub_ids, \"line_sale_prices\": line_sale_prices, \"line_is_credit\": line_is_credit})\n\n## Iteration\nline_ssp_nc = apply_each(line_sub_ids, \"multiply(lookup(line_ssp_amounts, line_sub_ids, each), subtract(1, lookup(line_is_credit, line_sub_ids, each)))\", {\"line_sub_ids\": line_sub_ids, \"line_ssp_amounts\": line_ssp_amounts, \"line_is_credit\": line_is_credit})\n\ntotal_sale_price = sum(line_sale_price_nc)\ntotal_ssp = sum(line_ssp_nc)\n## Iteration\nline_ratios = apply_each(line_sub_ids, \"if(eq(total_ssp, 0), 0, divide(lookup(line_ssp_amounts, line_sub_ids, each), total_ssp))\", {\"line_sub_ids\": line_sub_ids, \"line_ssp_amounts\": line_ssp_amounts, \"total_ssp\": total_ssp})\n\n## Iteration\nsub_recip = apply_each(line_sub_ids, \"divide(1, sum(eq(line_sub_ids, each)))\", {\"line_sub_ids\": line_sub_ids})\n\ndistinct_prod_count = sum(sub_recip)\n## Iteration\nline_base_alloc = apply_each(line_sub_ids, \"round(multiply(lookup(line_ratios, line_sub_ids, each), total_sale_price), 4)\", {\"line_sub_ids\": line_sub_ids, \"total_sale_price\": total_sale_price, \"line_ratios\": line_ratios})\n\n## Iteration\nline_base_alloc_adj = apply_each(line_sub_ids, \"if(gt(multiply(multiply(eq(total_ssp, 0), eq(distinct_prod_count, 1)), eq(lookup(line_ssp_amounts, line_sub_ids, each), 0)), 0), lookup(line_sale_prices, line_sub_ids, each), lookup(line_base_alloc, line_sub_ids, each))\", {\"line_sub_ids\": line_sub_ids, \"line_sale_prices\": line_sale_prices, \"line_ssp_amounts\": line_ssp_amounts, \"total_ssp\": total_ssp, \"distinct_prod_count\": distinct_prod_count, \"line_base_alloc\": line_base_alloc})\n\n## Iteration\nnoncredit_product_key = apply_each(line_sub_ids, \"if(eq(lookup(line_is_credit, line_sub_ids, each), 1), \\\"__CREDIT__\\\", lookup(line_products, line_sub_ids, each))\", {\"line_products\": line_products, \"line_sub_ids\": line_sub_ids, \"line_is_credit\": line_is_credit})\n\n## Iteration\nline_allocated = apply_each(line_sub_ids, \"if(eq(lookup(line_is_credit, line_sub_ids, each), 1), subtract(0, lookup(line_base_alloc_adj, noncredit_product_key, lookup(line_products, line_sub_ids, each))), lookup(line_base_alloc_adj, line_sub_ids, each))\", {\"line_products\": line_products, \"line_sub_ids\": line_sub_ids, \"line_is_credit\": line_is_credit, \"line_base_alloc_adj\": line_base_alloc_adj, \"noncredit_product_key\": noncredit_product_key})\n\nallocated_for_line = lookup(line_allocated, line_sub_ids, this_sub)\n## Iteration\ncat_product_u = apply_each(cat_product, \"upper(each)\", {\"cat_product\": cat_product})\n\ncat_parent_code = collect_all('SSP_RULE_parent_code')\ncat_parent_child = collect_all('SSP_RULE_parent_child')\n## Iteration\nd_prod = apply_each(line_sub_ids, \"upper(lookup(line_products, line_sub_ids, each))\", {\"line_products\": line_products, \"line_sub_ids\": line_sub_ids})\n\n## Iteration\nd_is_credit = apply_each(line_sub_ids, \"if(eq(lookup(d_prod, line_sub_ids, each), \\\"DISCOUNT-USD\\\"), 0, if(lt(lookup(line_sale_prices, line_sub_ids, each), 0), 1, if(eq(lookup(line_sale_prices, line_sub_ids, each), 0), if(lt(sum(multiply(eq(line_inv, lookup(line_inv, line_sub_ids, each)), line_sale_prices)), 0), 1, 0), 0)))\", {\"line_sub_ids\": line_sub_ids, \"line_sale_prices\": line_sale_prices, \"line_inv\": line_inv, \"d_prod\": d_prod})\n\n## Iteration\nd_policy = apply_each(line_sub_ids, \"lookup(cat_policy, cat_product_u, lookup(d_prod, line_sub_ids, each))\", {\"cat_policy\": cat_policy, \"line_sub_ids\": line_sub_ids, \"cat_product_u\": cat_product_u, \"d_prod\": d_prod})\n\n## Iteration\nd_ssp_raw = apply_each(line_sub_ids, \"if(eq(lookup(d_prod, line_sub_ids, each), \\\"DISCOUNT-USD\\\"), 0, if(eq(lookup(d_policy, line_sub_ids, each), \\\"DOLLAR_AMOUNT\\\"), lookup(cat_ssp_amount, cat_product_u, lookup(d_prod, line_sub_ids, each)), lookup(line_sale_prices, line_sub_ids, each)))\", {\"cat_ssp_amount\": cat_ssp_amount, \"line_sub_ids\": line_sub_ids, \"line_sale_prices\": line_sale_prices, \"cat_product_u\": cat_product_u, \"d_prod\": d_prod, \"d_policy\": d_policy})\n\nd_ssp_total = sum(d_ssp_raw)\n## Iteration\nd_ssp = apply_each(line_sub_ids, \"if(eq(lookup(d_prod, line_sub_ids, each), \\\"DISCOUNT-USD\\\"), 0, if(eq(d_ssp_total, 0), abs(lookup(line_sale_prices, line_sub_ids, each)), lookup(d_ssp_raw, line_sub_ids, each)))\", {\"line_sub_ids\": line_sub_ids, \"line_sale_prices\": line_sale_prices, \"d_prod\": d_prod, \"d_ssp_raw\": d_ssp_raw, \"d_ssp_total\": d_ssp_total})\n\n## Iteration\nd_group = apply_each(line_sub_ids, \"if(eq(upper(lookup(cat_parent_child, cat_product_u, lookup(d_prod, line_sub_ids, each))), \\\"CHILD\\\"), upper(lookup(cat_parent_code, cat_product_u, lookup(d_prod, line_sub_ids, each))), lookup(d_prod, line_sub_ids, each))\", {\"line_sub_ids\": line_sub_ids, \"cat_product_u\": cat_product_u, \"cat_parent_code\": cat_parent_code, \"cat_parent_child\": cat_parent_child, \"d_prod\": d_prod})\n\n## Iteration\nd_cancel = apply_each(line_sub_ids, \"if(gt(sum(multiply(multiply(multiply(eq(d_prod, lookup(d_group, line_sub_ids, each)), line_sale_prices), sub_recip), subtract(1, d_is_credit))), 0.005), if(lt(abs(sum(multiply(multiply(eq(d_prod, lookup(d_group, line_sub_ids, each)), line_sale_prices), sub_recip))), 0.005), 1, 0), 0)\", {\"line_sub_ids\": line_sub_ids, \"line_sale_prices\": line_sale_prices, \"sub_recip\": sub_recip, \"d_prod\": d_prod, \"d_is_credit\": d_is_credit, \"d_group\": d_group})\n\n## Iteration\nd_prod_recip = apply_each(line_sub_ids, \"divide(1, sum(multiply(eq(d_prod, lookup(d_prod, line_sub_ids, each)), sub_recip)))\", {\"line_sub_ids\": line_sub_ids, \"sub_recip\": sub_recip, \"d_prod\": d_prod})\n\nd_basis = sum(multiply(multiply(multiply(d_ssp, d_prod_recip), sub_recip), subtract(1, d_cancel)))\nd_money = sum(multiply(multiply(line_sale_prices, sub_recip), subtract(1, d_cancel)))\n## Iteration\nd_nc_count = apply_each(line_sub_ids, \"sum(multiply(multiply(eq(d_prod, lookup(d_prod, line_sub_ids, each)), subtract(1, d_is_credit)), sub_recip))\", {\"line_sub_ids\": line_sub_ids, \"sub_recip\": sub_recip, \"d_prod\": d_prod, \"d_is_credit\": d_is_credit})\n\n## Iteration\nd_prod_money = apply_each(line_sub_ids, \"sum(multiply(multiply(eq(d_prod, lookup(d_prod, line_sub_ids, each)), line_sale_prices), sub_recip))\", {\"line_sub_ids\": line_sub_ids, \"line_sale_prices\": line_sale_prices, \"sub_recip\": sub_recip, \"d_prod\": d_prod})\n\n## Iteration\nd_sub_net = apply_each(line_sub_ids, \"if(eq(lookup(d_is_credit, line_sub_ids, each), 1), 0, if(eq(lookup(d_cancel, line_sub_ids, each), 1), 0, if(eq(lookup(d_nc_count, line_sub_ids, each), 0), 0, divide(if(eq(lookup(d_policy, line_sub_ids, each), \\\"SALE_PRICE\\\"), lookup(d_prod_money, line_sub_ids, each), if(eq(d_basis, 0), 0, multiply(divide(lookup(d_ssp, line_sub_ids, each), d_basis), d_money))), lookup(d_nc_count, line_sub_ids, each)))))\", {\"line_sub_ids\": line_sub_ids, \"d_is_credit\": d_is_credit, \"d_policy\": d_policy, \"d_ssp\": d_ssp, \"d_cancel\": d_cancel, \"d_basis\": d_basis, \"d_money\": d_money, \"d_nc_count\": d_nc_count, \"d_prod_money\": d_prod_money})\n\n## Iteration\nd_line_bal = apply_each(line_sub_ids, \"sum(multiply(eq(bal_subids, each), bal_amounts))\", {\"bal_subids\": bal_subids, \"bal_amounts\": bal_amounts, \"line_sub_ids\": line_sub_ids})\n\n## Iteration\nd_sub_ltd = apply_each(line_sub_ids, \"if(eq(lookup(d_nc_count, line_sub_ids, each), 0), 0, divide(sum(multiply(multiply(eq(d_prod, lookup(d_prod, line_sub_ids, each)), d_line_bal), sub_recip)), lookup(d_nc_count, line_sub_ids, each)))\", {\"line_sub_ids\": line_sub_ids, \"sub_recip\": sub_recip, \"d_prod\": d_prod, \"d_nc_count\": d_nc_count, \"d_line_bal\": d_line_bal})\n\ndelivery_amount = round(multiply(units, allocated_for_line), 4)\ndelivery_ppa = if(gt(date_diff_days(end_of_month(delivery_effdate), end_of_month(postingdate)), 0), delivery_amount, 0)\ndelivery_revenue = if(lte(date_diff_days(end_of_month(delivery_effdate), end_of_month(postingdate)), 0), delivery_amount, 0)\n## Iteration\ndel_amount = apply_each(pdel_ids, \"round(multiply(if(gt(multiply(lookup(pdel_units, pdel_ids, each), lookup(d_sub_net, line_sub_ids, lookup(pdel_subids, pdel_ids, each))), if(lt(add(lookup(d_sub_net, line_sub_ids, lookup(pdel_subids, pdel_ids, each)), lookup(d_sub_ltd, line_sub_ids, lookup(pdel_subids, pdel_ids, each))), 0), 0, add(lookup(d_sub_net, line_sub_ids, lookup(pdel_subids, pdel_ids, each)), lookup(d_sub_ltd, line_sub_ids, lookup(pdel_subids, pdel_ids, each))))), if(lt(add(lookup(d_sub_net, line_sub_ids, lookup(pdel_subids, pdel_ids, each)), lookup(d_sub_ltd, line_sub_ids, lookup(pdel_subids, pdel_ids, each))), 0), 0, add(lookup(d_sub_net, line_sub_ids, lookup(pdel_subids, pdel_ids, each)), lookup(d_sub_ltd, line_sub_ids, lookup(pdel_subids, pdel_ids, each)))), multiply(lookup(pdel_units, pdel_ids, each), lookup(d_sub_net, line_sub_ids, lookup(pdel_subids, pdel_ids, each)))), if(eq(lookup(pdel_postings, pdel_ids, each), postingdate), 1, 0)), 4)\", {\"postingdate\": postingdate, \"pdel_ids\": pdel_ids, \"pdel_subids\": pdel_subids, \"pdel_units\": pdel_units, \"pdel_postings\": pdel_postings, \"line_sub_ids\": line_sub_ids, \"d_sub_net\": d_sub_net, \"d_sub_ltd\": d_sub_ltd})\n\n## Iteration\ndel_ispast = apply_each(pdel_ids, \"if(gt(date_diff_days(end_of_month(lookup(pdel_effdates, pdel_ids, each)), end_of_month(postingdate)), 0), 1, 0)\", {\"postingdate\": postingdate, \"pdel_ids\": pdel_ids, \"pdel_effdates\": pdel_effdates})\n\n## Iteration\ndel_subs = apply_each(pdel_ids, \"lookup(pdel_subids, pdel_ids, each)\", {\"pdel_ids\": pdel_ids, \"pdel_subids\": pdel_subids})\n\n## Iteration\ndel_ppa_neg = apply_each(pdel_ids, \"multiply(multiply(lookup(del_amount, pdel_ids, each), lookup(del_ispast, pdel_ids, each)), -1)\", {\"pdel_ids\": pdel_ids, \"del_amount\": del_amount, \"del_ispast\": del_ispast})\n\n## Iteration\ndel_rev_neg = apply_each(pdel_ids, \"multiply(multiply(lookup(del_amount, pdel_ids, each), subtract(1, lookup(del_ispast, pdel_ids, each))), -1)\", {\"pdel_ids\": pdel_ids, \"del_amount\": del_amount, \"del_ispast\": del_ispast})\n\ndel_amt_row = round(if(gt(multiply(units, allocated_for_line), if(lt(add(allocated_for_line, sum(multiply(eq(bal_subids, this_sub), bal_amounts))), 0), 0, add(allocated_for_line, sum(multiply(eq(bal_subids, this_sub), bal_amounts))))), if(lt(add(allocated_for_line, sum(multiply(eq(bal_subids, this_sub), bal_amounts))), 0), 0, add(allocated_for_line, sum(multiply(eq(bal_subids, this_sub), bal_amounts)))), multiply(units, allocated_for_line)), 4)\ndel_rev_row_neg = if(lte(date_diff_days(end_of_month(delivery_effdate), end_of_month(postingdate)), 0), multiply(del_amt_row, -1), 0)\ndel_ppa_row_neg = if(gt(date_diff_days(end_of_month(delivery_effdate), end_of_month(postingdate)), 0), multiply(del_amt_row, -1), 0)\n\n## Create Transactions\ncreateTransaction(postingdate, effectivedate, \"Revenue\", del_rev_neg, del_subs)\ncreateTransaction(postingdate, effectivedate, \"Revenue_PPA\", del_ppa_neg, del_subs)",
