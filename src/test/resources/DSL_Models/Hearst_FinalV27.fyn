          },
          {
            "id": "a20cb008-12aa-4a4a-879d-dc689d86bda9",
            "name": "pdel_units",
            "stepType": "calc",
            "source": "formula",
            "formula": "collect_by_instrument('PROF_SERVICE_DELIVERY_units_delivered')",
            "value": "",
            "eventField": "",
            "collectType": "collect_by_instrument"
          },
          {
            "id": "a1c01ea6-98e3-44e4-b4a4-f0ea84c5e525",
            "name": "pdel_postings",
            "stepType": "calc",
            "source": "formula",
            "formula": "collect_by_instrument('PROF_SERVICE_DELIVERY_postingdate')",
            "value": "",
            "eventField": "",
            "collectType": "collect_by_instrument"
          },
          {
            "id": "e0637bdf-357f-405d-a733-6dce52aa54d5",
            "name": "cur_delivery_units",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "sum(multiply(multiply(eq(pdel_subids, each), eq(pdel_postings, postingdate)), pdel_units))",
                "resultVar": "cur_delivery_units",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "d6c9c281-c2fb-46cb-987d-28d3ea73d048",
            "name": "line_policies",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "lookup(cat_policy, cat_product_u, lookup(line_products_u, subinstrumentid, each))",
                "resultVar": "line_policies"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "4ba23289-e1d2-4fe4-ada0-94f4c2beee17",
            "name": "line_ssp_dollar",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "lookup(cat_ssp_amount, cat_product_u, lookup(line_products_u, subinstrumentid, each))",
                "resultVar": "line_ssp_dollar"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "77879831-24e6-4ef8-86a6-bcbf3b04b5de",
            "name": "line_methods",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "lookup(cat_method, cat_product_u, lookup(line_products_u, subinstrumentid, each))",
                "resultVar": "line_methods"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "bd5df36a-c6fe-40bf-895c-b6542fe33fe0",
            "name": "line_ssp_raw",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_policies, subinstrumentid, each), \"DOLLAR_AMOUNT\"), lookup(line_ssp_dollar, subinstrumentid, each), lookup(line_sale_prices, subinstrumentid, each))",
                "resultVar": "line_ssp_raw",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "213fea18-3898-435b-b1e3-cdd33332f00b",
            "name": "total_ssp_raw",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(line_ssp_raw)",
            "value": "",
            "eventField": ""
          },
          {
            "id": "360160dd-0b84-4d25-880f-33cb509b4ea9",
            "name": "line_ssp_amounts",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_products_u, subinstrumentid, each), \"DISCOUNT-USD\"), 0, if(eq(total_ssp_raw, 0), abs(lookup(line_sale_prices, subinstrumentid, each)), lookup(line_ssp_raw, subinstrumentid, each)))",
                "resultVar": "line_ssp_amounts",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "ef0ebaa9-96fa-40e9-9426-bcc2f2976c2d",
            "name": "line_inv",
            "stepType": "calc",
            "source": "formula",
            "formula": "collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_INVOICE_NUMBER_CURRENT')",
            "value": "",
            "eventField": "",
            "collectType": "collect_by_instrument"
          },
          {
            "id": "d2c5f6ba-3ea5-46ee-96af-3b048c70514c",
            "name": "line_refinv",
            "stepType": "calc",
            "source": "formula",
            "formula": "collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_REFERENCE_INVOICE_NUMBER_CURRENT')",
            "value": "",
            "eventField": "",
            "collectType": "collect_by_instrument"
          },
          {
            "id": "9020c47c-58ce-4dad-9990-bc3150e01f10",
            "name": "line_is_credit",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "if(eq(lookup(line_products_u, subinstrumentid, each), \"DISCOUNT-USD\"), 0, if(lt(lookup(line_sale_prices, subinstrumentid, each), 0), 1, if(eq(lookup(line_sale_prices, subinstrumentid, each), 0), if(lt(sum(multiply(eq(line_inv, lookup(line_inv, subinstrumentid, each)), line_sale_prices)), 0), 1, 0), 0)))",
                "resultVar": "line_is_credit"
              }
            ],
            "commentText": "credit = negative price (Discount-USD excepted, any case); plus zero-priced lines on an invoice that nets negative (child lines of a credit note)"
          },
          {
            "id": "3d17b2b1-e081-4efb-b71f-a062585447c6",
            "name": "line_sale_price_nc",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "multiply(lookup(line_sale_prices, subinstrumentid, each), subtract(1, lookup(line_is_credit, subinstrumentid, each)))",
                "resultVar": "line_sale_price_nc"
              }
            ]
          },
          {
            "id": "00fe95c7-cf48-4395-8dfe-4a9c2e4a728c",
            "name": "line_ssp_nc",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "multiply(lookup(line_ssp_amounts, subinstrumentid, each), subtract(1, lookup(line_is_credit, subinstrumentid, each)))",
                "resultVar": "line_ssp_nc",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "d7942949-d8c4-4e68-94eb-f1c4ab39bed5",
            "name": "total_sale_price",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(line_sale_price_nc)",
            "value": "",
            "eventField": "",
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "86537acc-7af5-4988-9eed-6a99a1a94282",
            "name": "total_ssp",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(line_ssp_nc)",
            "value": "",
            "eventField": "",
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "7e016611-44a6-433e-aa39-350f21b3f97a",
            "name": "line_ratios",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(total_ssp, 0), 0, divide(lookup(line_ssp_amounts, subinstrumentid, each), total_ssp))",
                "resultVar": "line_ratios",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "ebc16e24-62f7-425f-a6fb-9aa491085876",
            "name": "sub_recip",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "divide(1, sum(eq(subinstrumentid, each)))",
                "resultVar": "sub_recip",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "c5eff108-08b3-4391-ad79-e2c810765efb",
            "name": "distinct_prod_count",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(sub_recip)",
            "value": "",
            "eventField": ""
          },
          {
            "id": "abdce62a-9a5f-4494-9fed-2918adf24caa",
            "name": "total_ssp_d",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(line_ssp_nc, sub_recip))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "709c7b0b-aaf9-4a37-888d-7a6954738da0",
            "name": "credit_pool_d",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(multiply(line_sale_prices, line_is_credit), sub_recip))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "7b3cb1bb-c0d8-42bf-ad77-c5ca4f591cdc",
            "name": "line_base_alloc",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "multiply(lookup(line_ratios, subinstrumentid, each), total_sale_price)",
                "resultVar": "line_base_alloc",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": true
          },
          {
            "id": "1dc38225-73b3-44fe-83d1-a97f8d30e233",
            "name": "line_base_alloc_adj",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "lookup(line_base_alloc, subinstrumentid, each)",
                "resultVar": "line_base_alloc_adj",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "d46de78b-ed67-4823-835a-2616fd3e80b8",
            "name": "noncredit_product_key",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_is_credit, subinstrumentid, each), 1), \"__CREDIT__\", lookup(line_products, subinstrumentid, each))",
                "resultVar": "noncredit_product_key",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "e2473a86-099f-4d34-bd39-975338f1aa68",
            "name": "line_ssp_eff",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_is_credit, subinstrumentid, each), 1), lookup(line_ssp_amounts, noncredit_product_key, lookup(line_products, subinstrumentid, each)), lookup(line_ssp_amounts, subinstrumentid, each))",
                "resultVar": "line_ssp_eff",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "b09d21b9-e156-49d3-b427-a51d50dc9c8f",
            "name": "line_group",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "if(eq(upper(lookup(cat_parent_child, cat_product_u, lookup(line_products_u, subinstrumentid, each))), \"CHILD\"), upper(lookup(cat_parent_code, cat_product_u, lookup(line_products_u, subinstrumentid, each))), lookup(line_products_u, subinstrumentid, each))",
                "resultVar": "line_group"
              }
            ]
          },
          {
            "id": "70fab409-53bd-4b6c-a68d-1d760ddb8b9e",
            "name": "line_cancelled",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "if(gt(sum(multiply(multiply(multiply(eq(line_products_u, lookup(line_group, subinstrumentid, each)), line_sale_prices), sub_recip), subtract(1, line_is_credit))), 0.005), if(lt(abs(sum(multiply(multiply(eq(line_products_u, lookup(line_group, subinstrumentid, each)), line_sale_prices), sub_recip))), 0.005), 1, 0), 0)",
                "resultVar": "line_cancelled"
              }
            ],
            "printResult": false
          },
          {
            "id": "4b331970-71e8-402d-9401-afa988bb96f5",
            "name": "prod_recip",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "divide(1, sum(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), sub_recip)))",
                "resultVar": "prod_recip",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "b70d50fc-516c-44c5-a091-6ed16f4b1a41",
            "name": "group_money",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "sum(multiply(multiply(eq(line_inv, lookup(line_inv, subinstrumentid, each)), line_sale_prices), sub_recip))",
                "resultVar": "group_money",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "e888fd6a-99d8-46e3-b63b-9fcc0297669f",
            "name": "ncred_prod",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(lt(sum(multiply(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), eq(line_inv, lookup(line_inv, subinstrumentid, each))), line_is_credit), sub_recip)), 1), 1, sum(multiply(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), eq(line_inv, lookup(line_inv, subinstrumentid, each))), line_is_credit), sub_recip)))",
                "resultVar": "ncred_prod",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "4d6a78f9-059b-4bdc-aca2-a35e6f9a029a",
            "name": "credit_pool_line",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "sum(multiply(multiply(multiply(eq(line_inv, lookup(line_inv, subinstrumentid, each)), line_is_credit), line_sale_prices), sub_recip))",
                "resultVar": "credit_pool_line",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "61738312-ba6c-40c0-bb8d-957c3666c830",
            "name": "unit_basis",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "sum(multiply(multiply(multiply(line_ssp_amounts, prod_recip), sub_recip), subtract(1, line_cancelled)))",
                "resultVar": "unit_basis",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "16826382-d0de-430d-b9c3-2f7148ad1633",
            "name": "unit_money",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "sum(multiply(multiply(line_sale_prices, sub_recip), subtract(1, line_cancelled)))",
                "resultVar": "unit_money",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "a2c374e3-68ab-43cd-a209-de574ad8b1dd",
            "name": "not_sp",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "if(eq(lookup(line_policies, subinstrumentid, each), \"SALE_PRICE\"), 0, 1)",
                "resultVar": "not_sp"
              }
            ],
            "commentText": "1 = SSP-allocated line, 0 = SALE_PRICE line (takes its own booking, stays out of the SSP pool)"
          },
          {
            "id": "9661513f-2cff-448a-81c5-75fd3b9cc28c",
            "name": "basis_all",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(multiply(multiply(line_ssp_amounts, prod_recip), sub_recip), not_sp))",
            "value": "",
            "eventField": "",
            "commentText": "SSP basis over every product, ignoring cancellation - used to keep a cancelled product's original allocation in place"
          },
          {
            "id": "4ecad652-82d7-44d4-809b-9a9d4c88ce43",
            "name": "money_nc",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(multiply(line_sale_price_nc, sub_recip), not_sp))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "31cc73d6-9b8c-44e8-a203-ac2ccb0fae66",
            "name": "cred_ratio",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "if(eq(lookup(line_is_credit, subinstrumentid, each), 0), 0, if(eq(sum(multiply(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), line_is_credit), group_money), sub_recip)), 0), 0, multiply(sum(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), subtract(1, line_is_credit)), sub_recip)), divide(lookup(group_money, subinstrumentid, each), sum(multiply(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), line_is_credit), group_money), sub_recip))))))",
                "resultVar": "cred_ratio"
              }
            ],
            "commentText": "share of the product's original allocation this credit line reverses: (# original lines) x (this line's credit-note money / all credit-note money on the product) - each credit note takes its own booking's share"
          },
          {
            "id": "b75612b6-d638-47b5-abce-7c44f93945ff",
            "name": "cancel_alloc",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "if(eq(lookup(line_policies, subinstrumentid, each), \"SALE_PRICE\"), lookup(line_sale_prices, subinstrumentid, each), if(eq(lookup(line_ssp_amounts, subinstrumentid, each), 0), 0, if(eq(basis_all, 0), 0, if(eq(lookup(line_is_credit, subinstrumentid, each), 1), multiply(multiply(divide(lookup(line_ssp_amounts, subinstrumentid, each), basis_all), money_nc), multiply(-1, lookup(cred_ratio, subinstrumentid, each))), multiply(divide(lookup(line_ssp_amounts, subinstrumentid, each), basis_all), money_nc)))))",
                "resultVar": "cancel_alloc"
              }
            ],
            "commentText": "cancelled product: original line keeps its gross allocation, credit line takes the exact negative (rule 5)"
          },
          {
            "id": "60db74fe-d1d7-4c2a-a420-984af5207c90",
            "name": "is_disc",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "if(eq(lookup(line_products_u, subinstrumentid, each), \"DISCOUNT-USD\"), 1, 0)",
                "resultVar": "is_disc"
              }
            ]
          },
          {
            "id": "4231a9ba-8276-4a06-b5b7-030c520b6701",
            "name": "live_recip",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "multiply(lookup(sub_recip, subinstrumentid, each), subtract(1, lookup(line_cancelled, subinstrumentid, each)))",
                "resultVar": "live_recip"
              }
            ],
            "commentText": "sub_recip for lines in non-cancelled groups, 0 otherwise"
          },
          {
            "id": "73ad6e8e-7b6d-44db-a8aa-894faa618f96",
            "name": "ssp_pool",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(multiply(multiply(line_ssp_amounts, prod_recip), live_recip), not_sp))",
            "value": "",
            "eventField": "",
            "commentText": "SSP basis of the SSP-allocated (non-SALE_PRICE) products still live; 0 = nothing can absorb a discount"
          },
          {
            "id": "2fe67975-45c3-4f3a-b3ce-5b2f84139be6",
            "name": "disc_money",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(multiply(line_sale_prices, is_disc), live_recip))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "4a3b191b-0b45-4a9d-bc80-f16142a2d40d",
            "name": "sp_money",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(multiply(line_sale_prices, subtract(1, not_sp)), live_recip))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "2dee95b6-8864-4203-9d30-0820ee362b83",
            "name": "line_alloc_raw",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_products_u, subinstrumentid, each), \"DISCOUNT-USD\"), 0, if(eq(lookup(line_cancelled, subinstrumentid, each), 1), lookup(cancel_alloc, subinstrumentid, each), if(eq(lookup(line_policies, subinstrumentid, each), \"SALE_PRICE\"), add(lookup(line_sale_prices, subinstrumentid, each), if(eq(ssp_pool, 0), if(eq(sp_money, 0), 0, multiply(disc_money, divide(lookup(line_sale_prices, subinstrumentid, each), sp_money))), 0)), if(eq(lookup(line_ssp_amounts, subinstrumentid, each), 0), 0, if(eq(lookup(unit_basis, subinstrumentid, each), 0), 0, if(eq(lookup(line_is_credit, subinstrumentid, each), 1), multiply(divide(lookup(line_ssp_amounts, subinstrumentid, each), lookup(unit_basis, subinstrumentid, each)), lookup(group_money, subinstrumentid, each)), multiply(divide(lookup(line_ssp_amounts, subinstrumentid, each), lookup(unit_basis, subinstrumentid, each)), subtract(lookup(unit_money, subinstrumentid, each), sum(multiply(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), line_is_credit), group_money), sub_recip))))))))))",
                "resultVar": "line_alloc_raw",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "0ea3ec58-7d19-4a99-93c1-1863406e0249",
            "name": "line_alloc_r",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "round(lookup(line_alloc_raw, subinstrumentid, each), 4)",
                "resultVar": "line_alloc_r",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "printResult": false
          },
          {
            "id": "a7672602-768b-48cd-811d-dc109ffcb567",
            "name": "total_sale_price_d",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(line_sale_price_nc, sub_recip))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "566dc1d6-23cd-46d2-a7e6-7453acbdf0bc",
            "name": "alloc_sum_r",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(line_alloc_r, sub_recip))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "3ef62fc9-6be4-43d9-8a56-eb33d2e99bbd",
            "name": "alloc_residual",
            "stepType": "calc",
            "source": "formula",
            "formula": "subtract(add(total_sale_price_d, credit_pool_d), alloc_sum_r)",
            "value": "",
            "eventField": ""
          },
          {
            "id": "c6185285-2408-493a-9e92-733f3cb2432f",
            "name": "alloc_max",
            "stepType": "calc",
            "source": "formula",
            "formula": "array_get(line_alloc_r, 0, 0)",
            "value": "",
            "eventField": ""
          },
          {
            "id": "c3b6e985-e8ea-4af0-909f-1f7e0c50477a",
            "name": "alloc_tied",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(eq(line_alloc_r, alloc_max), sub_recip))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "3c03b2da-59a0-44e9-8ae6-576f6c826b03",
            "name": "line_allocated",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "add(lookup(line_alloc_r, subinstrumentid, each), if(eq(alloc_tied, 0), 0, if(gte(abs(alloc_residual), 0.005), 0, if(eq(lookup(line_alloc_r, subinstrumentid, each), alloc_max), divide(alloc_residual, alloc_tied), 0))))",
                "resultVar": "line_allocated",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "488b86f6-225b-4531-b9e1-3a52d2be7340",
            "name": "line_prior",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "if(eq(date_diff_days(end_of_month(postingdate), end_of_month(lookup(boarding_month_end, subinstrumentid, each))), 0), 0, 1)",
                "resultVar": "line_prior"
              }
            ],
            "commentText": "1 = line boarded in an earlier month, 0 = boarded this posting month"
          },
          {
            "id": "8f17127a-ada3-439d-a6e1-00dbd6648557",
            "name": "any_new",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(subtract(1, line_prior), sub_recip))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "2aaf0feb-f056-4b09-86b5-419568ede969",
            "name": "line_cancelled_p",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "if(gt(sum(multiply(multiply(multiply(multiply(eq(line_products_u, lookup(line_group, subinstrumentid, each)), line_sale_prices), sub_recip), subtract(1, line_is_credit)), line_prior)), 0.005), if(lt(abs(sum(multiply(multiply(multiply(eq(line_products_u, lookup(line_group, subinstrumentid, each)), line_sale_prices), sub_recip), line_prior))), 0.005), 1, 0), 0)",
                "resultVar": "line_cancelled_p"
              }
            ]
          },
          {
            "id": "0688a981-d06d-4c3a-b9e1-cc71f1e5b710",
            "name": "prod_recip_p",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "if(eq(sum(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), sub_recip), line_prior)), 0), 0, divide(1, sum(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), sub_recip), line_prior))))",
                "resultVar": "prod_recip_p"
              }
            ]
          },
          {
            "id": "1f881fdf-a037-4bb6-837e-dfe8778efe0a",
            "name": "unit_basis_p",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(multiply(multiply(multiply(line_ssp_amounts, prod_recip_p), sub_recip), subtract(1, line_cancelled_p)), line_prior))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "decc040e-d488-4d3f-80ab-5610284cc0ac",
            "name": "unit_money_p",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(multiply(multiply(line_sale_prices, sub_recip), subtract(1, line_cancelled_p)), line_prior))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "75c378ba-8bbb-44cc-bc5d-0c42dca4ab94",
            "name": "basis_all_p",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(multiply(multiply(multiply(line_ssp_amounts, prod_recip_p), sub_recip), line_prior), not_sp))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "a0cc5d13-6a36-40bf-958d-2ee647010d32",
            "name": "money_nc_p",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(multiply(multiply(line_sale_price_nc, sub_recip), line_prior), not_sp))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "8e503804-f661-41e7-a38d-5c67fb0d8339",
            "name": "credit_prior",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "multiply(lookup(line_is_credit, subinstrumentid, each), lookup(line_prior, subinstrumentid, each))",
                "resultVar": "credit_prior"
              }
            ]
          },
          {
            "id": "fdab685b-98c1-4d06-9dc8-a9b4f51afd2b",
            "name": "noncredit_prior",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "multiply(subtract(1, lookup(line_is_credit, subinstrumentid, each)), lookup(line_prior, subinstrumentid, each))",
                "resultVar": "noncredit_prior"
              }
            ]
          },
          {
            "id": "1851d056-56da-468c-aec6-4dc38eae75a1",
            "name": "cred_ratio_p",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "if(eq(lookup(credit_prior, subinstrumentid, each), 0), 0, if(eq(sum(multiply(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), credit_prior), group_money), sub_recip)), 0), 0, multiply(sum(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), noncredit_prior), sub_recip)), divide(lookup(group_money, subinstrumentid, each), sum(multiply(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), credit_prior), group_money), sub_recip))))))",
                "resultVar": "cred_ratio_p"
              }
            ]
          },
          {
            "id": "50f8f078-4ca0-4e82-b3e4-b37c8b32d3e1",
            "name": "cancel_alloc_p",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "if(eq(lookup(line_policies, subinstrumentid, each), \"SALE_PRICE\"), lookup(line_sale_prices, subinstrumentid, each), if(eq(lookup(line_ssp_amounts, subinstrumentid, each), 0), 0, if(eq(basis_all_p, 0), 0, if(eq(lookup(line_is_credit, subinstrumentid, each), 1), multiply(multiply(divide(lookup(line_ssp_amounts, subinstrumentid, each), basis_all_p), money_nc_p), multiply(-1, lookup(cred_ratio_p, subinstrumentid, each))), multiply(divide(lookup(line_ssp_amounts, subinstrumentid, each), basis_all_p), money_nc_p)))))",
                "resultVar": "cancel_alloc_p"
              }
            ]
          },
          {
            "id": "f45493a1-9e6e-4927-8484-698960ab0cc3",
            "name": "group_money_prior",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "multiply(lookup(group_money, subinstrumentid, each), lookup(line_prior, subinstrumentid, each))",
                "resultVar": "group_money_prior"
              }
            ]
          },
          {
            "id": "1801e66a-60ba-4353-9b36-bdb15abe82bd",
            "name": "cred_money_p",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "sum(multiply(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), line_is_credit), group_money_prior), sub_recip))",
                "resultVar": "cred_money_p"
              }
            ]
          },
          {
            "id": "71cec65d-4e1a-4676-a51b-47440d7e660d",
            "name": "live_recip_p",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "multiply(multiply(lookup(sub_recip, subinstrumentid, each), subtract(1, lookup(line_cancelled_p, subinstrumentid, each))), lookup(line_prior, subinstrumentid, each))",
                "resultVar": "live_recip_p"
              }
            ]
          },
          {
            "id": "08d723ee-def6-4f11-b3c8-3be113f5941e",
            "name": "ssp_pool_p",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(multiply(multiply(line_ssp_amounts, prod_recip_p), live_recip_p), not_sp))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "d46000dc-4d14-45ac-b387-23ded7d6cd58",
            "name": "disc_money_p",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(multiply(line_sale_prices, is_disc), live_recip_p))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "d7378ba3-e6fd-44de-8992-a6acc866cd1e",
            "name": "sp_money_p",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(multiply(line_sale_prices, subtract(1, not_sp)), live_recip_p))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "4b717397-1b9d-4a88-a488-ae15e26991e8",
            "name": "line_alloc_raw_p",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "if(eq(lookup(line_prior, subinstrumentid, each), 0), 0, if(eq(lookup(line_products_u, subinstrumentid, each), \"DISCOUNT-USD\"), 0, if(eq(lookup(line_cancelled_p, subinstrumentid, each), 1), lookup(cancel_alloc_p, subinstrumentid, each), if(eq(lookup(line_policies, subinstrumentid, each), \"SALE_PRICE\"), add(lookup(line_sale_prices, subinstrumentid, each), if(eq(ssp_pool_p, 0), if(eq(sp_money_p, 0), 0, multiply(disc_money_p, divide(lookup(line_sale_prices, subinstrumentid, each), sp_money_p))), 0)), if(eq(lookup(line_ssp_amounts, subinstrumentid, each), 0), 0, if(eq(unit_basis_p, 0), 0, if(eq(lookup(line_is_credit, subinstrumentid, each), 1), multiply(divide(lookup(line_ssp_amounts, subinstrumentid, each), unit_basis_p), lookup(group_money, subinstrumentid, each)), multiply(divide(lookup(line_ssp_amounts, subinstrumentid, each), unit_basis_p), subtract(unit_money_p, lookup(cred_money_p, subinstrumentid, each))))))))))",
                "resultVar": "line_alloc_raw_p"
              }
            ],
            "commentText": "line_alloc_raw recomputed over lines boarded before this month only (the allocation already posted)"
          },
          {
            "id": "1304b6e0-0799-4688-b150-0b9c39391d87",
            "name": "line_alloc_r_p",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "round(lookup(line_alloc_raw_p, subinstrumentid, each), 4)",
                "resultVar": "line_alloc_r_p"
              }
            ]
          },
          {
            "id": "d74bdf4c-1a15-45a1-83f9-1a39ae04eeb4",
            "name": "alloc_residual_p",
            "stepType": "calc",
            "source": "formula",
            "formula": "subtract(add(sum(multiply(multiply(line_sale_price_nc, sub_recip), line_prior)), sum(multiply(multiply(multiply(line_sale_prices, line_is_credit), sub_recip), line_prior))), sum(multiply(line_alloc_r_p, sub_recip)))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "81d67e36-ff9d-49bd-b862-ee743ded846c",
            "name": "alloc_max_p",
            "stepType": "calc",
            "source": "formula",
            "formula": "array_get(line_alloc_r_p, 0, 0)",
            "value": "",
            "eventField": ""
          },
          {
            "id": "dacf4937-c9aa-4be9-bda1-21ef02eb1c76",
            "name": "alloc_tied_p",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(multiply(eq(line_alloc_r_p, alloc_max_p), sub_recip), line_prior))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "e2f1187a-c76f-4dfa-8fb5-911cc7ddf4b4",
            "name": "line_allocated_p",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "multiply(lookup(line_prior, subinstrumentid, each), add(lookup(line_alloc_r_p, subinstrumentid, each), if(eq(alloc_tied_p, 0), 0, if(gte(abs(alloc_residual_p), 0.005), 0, if(eq(lookup(line_alloc_r_p, subinstrumentid, each), alloc_max_p), divide(alloc_residual_p, alloc_tied_p), 0)))))",
                "resultVar": "line_allocated_p"
              }
            ]
          },
          {
            "id": "41cf8cdd-1fac-4cc5-ace0-5842469ee8d6",
            "name": "alloc_delta",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "if(eq(lookup(line_prior, subinstrumentid, each), 0), 0, if(eq(any_new, 0), 0, round(subtract(lookup(line_allocated, subinstrumentid, each), lookup(line_allocated_p, subinstrumentid, each)), 4)))",
                "resultVar": "alloc_delta"
              }
            ],
            "commentText": "allocation true-up for lines boarded earlier: new allocation minus allocation already posted. Telescopes, so cumulative ALLOCATED_REVENUE always equals current line_allocated."
          },
          {
            "id": "b0a7cb5f-4d66-42db-8645-8d19fb047844",
            "name": "line_balance",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "sum(multiply(eq(bal_subids, each), bal_amounts))",
                "resultVar": "line_balance",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "keyed by sub-id, not positional; yields 0 when a line has no balance row yet",
            "printResult": false
          },
          {
            "id": "4fcd460a-7b2c-4204-802a-9ca799e61d36",
            "name": "bal_postings",
            "stepType": "calc",
            "source": "formula",
            "formula": "collect_by_instrument('REVENUE_BALANCE_postingdate')",
            "value": "",
            "eventField": "",
            "commentText": "posting date carried on this instrument's balance rows"
          },
          {
            "id": "e22ce518-75d4-4fae-b7c3-6cce32e50cfe",
            "name": "stale_balance_error",
            "stepType": "calc",
            "source": "formula",
            "formula": "if(eq(array_length(bal_postings), 0), 0, if(eq(date_diff_days(array_get(bal_postings, 0, postingdate), postingdate), 0), 0, 1))",
            "value": "",
            "eventField": "",
            "commentText": "CONTROL - 1 when a balance row exists but is not for this posting period, i.e. the prior period's balance was never written. Must be 0.",
            "printResult": true
          },
          {
            "id": "46d7d512-f479-4066-a938-259d43979b95",
            "name": "balance_row_count",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "sum(eq(bal_subids, each))",
                "resultVar": "balance_row_count",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "commentText": "count of balance rows matching each order line - must be 1 (or 0 before the first balance is written). 2+ means duplicates are double-counting the balance.",
            "printResult": false
          },
          {
            "id": "5a545be1-de2e-46c6-8535-77be71e0b12b",
            "name": "balance_alignment_error",
            "stepType": "calc",
            "source": "formula",
            "formula": "if(gt(sum(balance_row_count), array_length(bal_subids)), 1, 0)",
            "value": "",
            "eventField": "",
            "commentText": "CONTROL - 1 when any order line has more than one balance row, i.e. the balance feed has duplicates. Must be 0.",
            "printResult": true
          },
          {
            "id": "01882485-6e06-4c05-b6c5-44324e8e13f5",
            "name": "prod_nc_count",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "sum(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), subtract(1, line_is_credit)), sub_recip))",
                "resultVar": "prod_nc_count"
              }
            ]
          },
          {
            "id": "6dce3cf2-bfa3-4000-9484-748a0e601240",
            "name": "prod_alloc_sum",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "sum(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), line_allocated), sub_recip))",
                "resultVar": "prod_alloc_sum"
              }
            ]
          },
          {
            "id": "a1674201-0e33-47d3-8750-0dae9a9946d7",
            "name": "prod_bal_sum",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "sum(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), line_balance), sub_recip))",
                "resultVar": "prod_bal_sum"
              }
            ]
          },
          {
            "id": "ea4c35ef-947a-49d0-8fab-771ddd867d07",
            "name": "cur_delivery_amount",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "if(eq(lookup(line_is_credit, subinstrumentid, each), 1), 0, if(eq(lookup(prod_nc_count, subinstrumentid, each), 0), 0, if(gt(multiply(lookup(cur_delivery_units, subinstrumentid, each), divide(lookup(prod_alloc_sum, subinstrumentid, each), lookup(prod_nc_count, subinstrumentid, each))), if(lt(divide(add(lookup(prod_alloc_sum, subinstrumentid, each), lookup(prod_bal_sum, subinstrumentid, each)), lookup(prod_nc_count, subinstrumentid, each)), 0), 0, divide(add(lookup(prod_alloc_sum, subinstrumentid, each), lookup(prod_bal_sum, subinstrumentid, each)), lookup(prod_nc_count, subinstrumentid, each)))), if(lt(divide(add(lookup(prod_alloc_sum, subinstrumentid, each), lookup(prod_bal_sum, subinstrumentid, each)), lookup(prod_nc_count, subinstrumentid, each)), 0), 0, divide(add(lookup(prod_alloc_sum, subinstrumentid, each), lookup(prod_bal_sum, subinstrumentid, each)), lookup(prod_nc_count, subinstrumentid, each))), multiply(lookup(cur_delivery_units, subinstrumentid, each), divide(lookup(prod_alloc_sum, subinstrumentid, each), lookup(prod_nc_count, subinstrumentid, each))))))",
                "resultVar": "cur_delivery_amount"
              }
            ],
            "commentText": "mirrors REVREC_Proportional_Delivery: units x product NET allocation per non-credit line, capped at the product's remaining"
          },
          {
            "id": "e82eab77-0f2b-497d-8294-043a14f04892",
            "name": "line_remaining",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_methods, subinstrumentid, each), \"PROPORTIONAL_PERFORMANCE\"), subtract(add(lookup(line_allocated, subinstrumentid, each), lookup(line_balance, subinstrumentid, each)), lookup(cur_delivery_amount, subinstrumentid, each)), if(gte(lookup(line_allocated, subinstrumentid, each), 0), max(subtract(lookup(line_allocated, subinstrumentid, each), lookup(line_balance, subinstrumentid, each)), 0), min(subtract(lookup(line_allocated, subinstrumentid, each), lookup(line_balance, subinstrumentid, each)), 0)))",
                "resultVar": "line_remaining",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "printResult": true
          },
          {
            "id": "71480db9-b4e6-48a9-826a-3e7192d807bb",
            "name": "line_po_days",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "add(date_diff_days(lookup(line_starts, subinstrumentid, each), lookup(line_ends, subinstrumentid, each)), 1)",
                "resultVar": "line_po_days",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "f7589e97-e90a-4855-8a8e-8bc131125046",
            "name": "line_per_day",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_po_days, subinstrumentid, each), 0), 0, divide(lookup(line_allocated, subinstrumentid, each), lookup(line_po_days, subinstrumentid, each)))",
                "resultVar": "line_per_day",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "3463fe38-553c-492b-a0ab-d8933dfc70e7",
            "name": "line_is_ratable",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_methods, subinstrumentid, each), \"RATABLE\"), 1, 0)",
                "resultVar": "line_is_ratable",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "a03b3b65-aa32-44a0-8317-52b2ea493199",
            "name": "line_is_pit",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_methods, subinstrumentid, each), \"POINT_IN_TIME\"), 1, 0)",
                "resultVar": "line_is_pit",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "4c0eb53c-7930-4eff-b5af-18cc04e1bb86",
            "name": "line_is_prop",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_methods, subinstrumentid, each), \"PROPORTIONAL_PERFORMANCE\"), 1, 0)",
                "resultVar": "line_is_prop",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "d96b3e1d-93a9-4081-886a-0b4b36af74d1",
            "name": "line_ends_eom",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "end_of_month(lookup(line_ends, subinstrumentid, each))",
                "resultVar": "line_ends_eom",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "2d89ca2e-73f4-404e-9666-d0f99b8b2cc4",
            "name": "rev_schedule",
            "stepType": "schedule",
            "scheduleConfig": {
              "periodType": "date",
              "startDate": "",
              "startDateSource": "formula",
              "startDateField": "",
              "startDateFormula": "line_starts",
              "endDate": "",
              "endDateSource": "formula",
              "endDateField": "",
              "endDateFormula": "line_ends_eom",
              "periodCount": "12",
              "periodCountSource": "value",
              "periodCountField": "",
              "periodCountFormula": "",
              "frequency": "M",
              "convention": "",
              "columns": [
                {
                  "name": "period_date",
                  "formula": "period_date"
                },
                {
                  "formula": "end_of_month(period_date)",
                  "name": "month_end"
                },
                {
                  "formula": "add(date_diff_days(if(gt(date_diff_days(start_of_month(month_end), line_starts), 0), line_starts, start_of_month(month_end)), if(gt(date_diff_days(line_ends, month_end), 0), line_ends, month_end)), 1)",
                  "name": "days_in_month",
                  "commentText": "days of service falling in this month - prorated for mid-month start or end"
                },
                {
                  "formula": "add(period_index, 1)",
                  "name": "period_no"
                },
                {
                  "formula": "date_diff_days(line_starts, start_of_month(month_end))",
                  "name": "prior_ltd_days"
                },
                {
                  "formula": "if(eq(date_diff_days(month_end, end_of_month(line_ends)), 0), 1, 0)",
                  "name": "is_last"
                },
                {
                  "formula": "if(eq(line_is_ratable, 1), multiply(line_per_day, days_in_month), if(eq(line_is_pit, 1), if(eq(date_diff_days(month_end, end_of_month(line_starts)), 0), line_allocated, 0), if(eq(line_is_prop, 1), if(eq(is_last, 1), line_remaining, 0), if(eq(is_last, 1), line_allocated, 0))))",
                  "name": "gross_calc",
                  "commentText": "RATABLE = per-day x days of service in this month (no duration column). POINT_IN_TIME = full amount in the month containing service start. PROPORTIONAL = remaining balance at service end."
                },
                {
                  "formula": "lag('ltd_gross', 1, 0)",
                  "name": "cum_prior"
                },
                {
                  "formula": "if(eq(multiply(is_last, line_is_ratable), 1), subtract(line_allocated, cum_prior), gross_calc)",
                  "name": "gross_revenue"
                },
                {
                  "formula": "end_of_month(boarding_month_end)",
                  "name": "boarding_me"
                },
                {
                  "formula": "if(gt(date_diff_days(month_end, boarding_me), 0), gross_revenue, 0)",
                  "name": "pre_gross"
                },
                {
                  "formula": "add(lag('cum_pre', 1, 0), pre_gross)",
                  "name": "cum_pre"
                },
                {
                  "formula": "round(if(eq(date_diff_days(month_end, boarding_me), 0), lag('cum_pre', 1, 0), 0), 4)",
                  "name": "revenue_ppa"
                },
                {
                  "formula": "if(lte(date_diff_days(month_end, boarding_me), 0), gross_revenue, 0)",
                  "name": "revenue"
                },
                {
                  "formula": "add(lag('ltd_gross', 1, 0), gross_revenue)",
                  "name": "ltd_gross"
                }
              ],
              "outputs": [
                {
                  "id": "o_1789167075256_0",
                  "type": "filter",
                  "name": "rev_now",
                  "column": "revenue",
                  "matchCol": "month_end",
                  "matchValue": "postingdate"
                },
                {
                  "id": "o_1789167075256_1",
                  "type": "filter",
                  "name": "ppa_now",
                  "column": "revenue_ppa",
                  "matchCol": "month_end",
                  "matchValue": "postingdate"
                },
                {
                  "id": "o_1789167075256_2",
                  "type": "sum",
                  "name": "posted_rev_total",
                  "column": "revenue",
                  "matchCol": "",
                  "matchValue": ""
                },
                {
                  "id": "o_1789167075256_3",
                  "type": "last",
                  "name": "ltd_close",
                  "column": "ltd_gross",
                  "matchCol": "",
                  "matchValue": ""
                }
              ],
              "contextVars": [
                "boarding_month_end",
                "line_allocated",
                "line_ends",
                "line_is_pit",
                "line_is_prop",
                "line_is_ratable",
                "line_per_day",
                "line_remaining",
                "line_starts"
              ],
              "itemNames": "line_products"
            },
            "outputVars": [
              {
                "name": "rev_now",
                "type": "filter",
                "column": "revenue",
                "matchCol": "month_end",
                "matchValue": "postingdate"
              },
              {
                "name": "ppa_now",
                "type": "filter",
                "column": "revenue_ppa",
                "matchCol": "month_end",
                "matchValue": "postingdate"
              },
              {
                "name": "posted_rev_total",
                "type": "sum",
                "column": "revenue"
              },
              {
                "name": "ltd_close",
                "type": "last",
                "column": "ltd_gross"
              }
            ]
          },
          {
            "id": "8122fe70-dac4-4482-8cad-8bdaf1b7ff44",
            "name": "ppa_amount",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "round(lookup(ppa_now, subinstrumentid, each), 4)",
                "resultVar": "ppa_amount",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "printResult": false,
            "inlineComment": false,
            "commentText": ""
          },
          {
            "id": "ecfe30c3-a8d2-47a4-ae1c-bfa2779a2634",
            "name": "late_credit_ppa",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(gt(multiply(gt(date_diff_days(end_of_month(lookup(line_ends, subinstrumentid, each)), end_of_month(lookup(boarding_month_end, subinstrumentid, each))), 0), eq(date_diff_days(end_of_month(postingdate), end_of_month(lookup(boarding_month_end, subinstrumentid, each))), 0)), 0), lookup(line_allocated, subinstrumentid, each), 0)",
                "resultVar": "late_credit_ppa",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "51048a64-8bca-46c2-a8e8-232204d84783",
            "name": "rat_target",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
