      {
        "name": "REVREC_Revenue_Recognition",
        "priority": 110,
        "ruleType": "schedule",
        "generatedCode": "## ═══════════════════════════════════════════════════════════════\n## REVREC_REVENUE_RECOGNITION\n## ═══════════════════════════════════════════════════════════════\n\n## Steps\npostingdate = SALE_ORDER_DETAILS.postingdate\neffectivedate = SALE_ORDER_DETAILS.postingdate\nsubinstrumentid = collect_by_instrument(SALE_ORDER_DETAILS.subinstrumentid)\nregister_ssp = collect_all(SSP_RULE.ssp_amount)\nregister_balance = collect_by_instrument(REVENUE_BALANCE.BALANCES_ENDINGBALANCE_TOTAL_REVENUE)\ncat_product = collect_all('SSP_RULE_product_code')\ncat_policy = collect_all('SSP_RULE_standalone_price_policy')\ncat_ssp_amount = collect_all('SSP_RULE_ssp_amount')\ncat_method = collect_all('SSP_RULE_recognition_method')\ncat_parent_code = collect_all('SSP_RULE_parent_code')\ncat_parent_child = collect_all('SSP_RULE_parent_child')\n## Iteration\ncat_product_u = apply_each(cat_product, \"upper(each)\", {\"cat_product\": cat_product})\n\nline_products = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_PRODUCT_ID_CURRENT')\n## Iteration\nline_products_u = apply_each(line_products, \"upper(each)\", {\"line_products\": line_products})\n\nline_sale_prices = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_SALE_PRICE_CURRENT')\nline_starts_raw = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_SERVICE_START_DATE_CURRENT')\nline_ends_raw = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_SERVICE_END_DATE_CURRENT')\ndl_inv = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_INVOICE_NUMBER_CURRENT')\n## Iteration\ndl_nc_key = apply_each(subinstrumentid, \"if(eq(lookup(line_products_u, subinstrumentid, each), \\\"DISCOUNT-USD\\\"), lookup(line_products, subinstrumentid, each), if(lt(lookup(line_sale_prices, subinstrumentid, each), 0), \\\"__CREDIT__\\\", if(eq(lookup(line_sale_prices, subinstrumentid, each), 0), if(lt(sum(multiply(eq(dl_inv, lookup(dl_inv, subinstrumentid, each)), line_sale_prices)), 0), \\\"__CREDIT__\\\", lookup(line_products, subinstrumentid, each)), lookup(line_products, subinstrumentid, each))))\", {\"subinstrumentid\": subinstrumentid, \"line_products\": line_products, \"line_products_u\": line_products_u, \"line_sale_prices\": line_sale_prices, \"dl_inv\": dl_inv})\n\n## Iteration\nline_starts = apply_each(subinstrumentid, \"if(eq(lookup(dl_nc_key, subinstrumentid, each), \\\"__CREDIT__\\\"), if(gt(sum(eq(dl_nc_key, lookup(line_products, subinstrumentid, each))), 0), if(gt(date_diff_days(lookup(line_ends_raw, dl_nc_key, lookup(line_products, subinstrumentid, each)), lookup(line_ends_raw, subinstrumentid, each)), 0), lookup(line_starts_raw, dl_nc_key, lookup(line_products, subinstrumentid, each)), lookup(line_starts_raw, subinstrumentid, each)), lookup(line_starts_raw, subinstrumentid, each)), lookup(line_starts_raw, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"line_products\": line_products, \"line_starts_raw\": line_starts_raw, \"line_ends_raw\": line_ends_raw, \"dl_nc_key\": dl_nc_key})\n\n## Iteration\nline_ends = apply_each(subinstrumentid, \"if(eq(lookup(dl_nc_key, subinstrumentid, each), \\\"__CREDIT__\\\"), if(gt(sum(eq(dl_nc_key, lookup(line_products, subinstrumentid, each))), 0), if(gt(date_diff_days(lookup(line_ends_raw, dl_nc_key, lookup(line_products, subinstrumentid, each)), lookup(line_ends_raw, subinstrumentid, each)), 0), lookup(line_ends_raw, dl_nc_key, lookup(line_products, subinstrumentid, each)), lookup(line_ends_raw, subinstrumentid, each)), lookup(line_ends_raw, subinstrumentid, each)), lookup(line_ends_raw, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"line_products\": line_products, \"line_ends_raw\": line_ends_raw, \"dl_nc_key\": dl_nc_key})\n\nmissing_order_terms = if(eq(array_length(subinstrumentid), 0), 1, 0)\nline_postings = collect_by_instrument('SALE_ORDER_DETAILS_postingdate')\nbal_subids = collect_by_instrument('REVENUE_BALANCE_subinstrumentid')\nbal_amounts = collect_by_instrument('REVENUE_BALANCE_BALANCES_ENDINGBALANCE_TOTAL_REVENUE')\nboarding_month_end = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_TRANSACTIONDATE_CURRENT')\nregister_delivery = collect_by_instrument(PROF_SERVICE_DELIVERY.units_delivered)\npdel_subids = collect_by_instrument('PROF_SERVICE_DELIVERY_subinstrumentid')\npdel_units = collect_by_instrument('PROF_SERVICE_DELIVERY_units_delivered')\npdel_postings = collect_by_instrument('PROF_SERVICE_DELIVERY_postingdate')\n## Iteration\ncur_delivery_units = apply_each(subinstrumentid, \"sum(multiply(multiply(eq(pdel_subids, each), eq(pdel_postings, postingdate)), pdel_units))\", {\"postingdate\": postingdate, \"subinstrumentid\": subinstrumentid, \"pdel_subids\": pdel_subids, \"pdel_units\": pdel_units, \"pdel_postings\": pdel_postings})\n\n## Iteration\nline_policies = apply_each(subinstrumentid, \"lookup(cat_policy, cat_product_u, lookup(line_products_u, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"cat_policy\": cat_policy, \"cat_product_u\": cat_product_u, \"line_products_u\": line_products_u})\n\n## Iteration\nline_ssp_dollar = apply_each(subinstrumentid, \"lookup(cat_ssp_amount, cat_product_u, lookup(line_products_u, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"cat_ssp_amount\": cat_ssp_amount, \"cat_product_u\": cat_product_u, \"line_products_u\": line_products_u})\n\n## Iteration\nline_methods = apply_each(subinstrumentid, \"lookup(cat_method, cat_product_u, lookup(line_products_u, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"cat_method\": cat_method, \"cat_product_u\": cat_product_u, \"line_products_u\": line_products_u})\n\n## Iteration\nline_ssp_raw = apply_each(subinstrumentid, \"if(eq(lookup(line_policies, subinstrumentid, each), \\\"DOLLAR_AMOUNT\\\"), lookup(line_ssp_dollar, subinstrumentid, each), lookup(line_sale_prices, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"line_sale_prices\": line_sale_prices, \"line_policies\": line_policies, \"line_ssp_dollar\": line_ssp_dollar})\n\ntotal_ssp_raw = sum(line_ssp_raw)\n## Iteration\nline_ssp_amounts = apply_each(subinstrumentid, \"if(eq(lookup(line_products_u, subinstrumentid, each), \\\"DISCOUNT-USD\\\"), 0, if(eq(total_ssp_raw, 0), abs(lookup(line_sale_prices, subinstrumentid, each)), lookup(line_ssp_raw, subinstrumentid, each)))\", {\"subinstrumentid\": subinstrumentid, \"line_products_u\": line_products_u, \"line_sale_prices\": line_sale_prices, \"line_ssp_raw\": line_ssp_raw, \"total_ssp_raw\": total_ssp_raw})\n\nline_inv = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_INVOICE_NUMBER_CURRENT')\nline_refinv = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_REFERENCE_INVOICE_NUMBER_CURRENT')\n## Iteration\nline_is_credit = apply_each(subinstrumentid, \"if(eq(lookup(line_products_u, subinstrumentid, each), \\\"DISCOUNT-USD\\\"), 0, if(lt(lookup(line_sale_prices, subinstrumentid, each), 0), 1, if(eq(lookup(line_sale_prices, subinstrumentid, each), 0), if(lt(sum(multiply(eq(line_inv, lookup(line_inv, subinstrumentid, each)), line_sale_prices)), 0), 1, 0), 0)))\", {\"subinstrumentid\": subinstrumentid, \"line_products_u\": line_products_u, \"line_sale_prices\": line_sale_prices, \"line_inv\": line_inv})\n\n## Iteration\nline_sale_price_nc = apply_each(subinstrumentid, \"multiply(lookup(line_sale_prices, subinstrumentid, each), subtract(1, lookup(line_is_credit, subinstrumentid, each)))\", {\"subinstrumentid\": subinstrumentid, \"line_sale_prices\": line_sale_prices, \"line_is_credit\": line_is_credit})\n\n## Iteration\nline_ssp_nc = apply_each(subinstrumentid, \"multiply(lookup(line_ssp_amounts, subinstrumentid, each), subtract(1, lookup(line_is_credit, subinstrumentid, each)))\", {\"subinstrumentid\": subinstrumentid, \"line_ssp_amounts\": line_ssp_amounts, \"line_is_credit\": line_is_credit})\n\ntotal_sale_price = sum(line_sale_price_nc)\ntotal_ssp = sum(line_ssp_nc)\n## Iteration\nline_ratios = apply_each(subinstrumentid, \"if(eq(total_ssp, 0), 0, divide(lookup(line_ssp_amounts, subinstrumentid, each), total_ssp))\", {\"subinstrumentid\": subinstrumentid, \"line_ssp_amounts\": line_ssp_amounts, \"total_ssp\": total_ssp})\n\n## Iteration\nsub_recip = apply_each(subinstrumentid, \"divide(1, sum(eq(subinstrumentid, each)))\", {\"subinstrumentid\": subinstrumentid})\n\ndistinct_prod_count = sum(sub_recip)\ntotal_ssp_d = sum(multiply(line_ssp_nc, sub_recip))\ncredit_pool_d = sum(multiply(multiply(line_sale_prices, line_is_credit), sub_recip))\n## Iteration\nline_base_alloc = apply_each(subinstrumentid, \"multiply(lookup(line_ratios, subinstrumentid, each), total_sale_price)\", {\"subinstrumentid\": subinstrumentid, \"total_sale_price\": total_sale_price, \"line_ratios\": line_ratios})\n\n## Iteration\nline_base_alloc_adj = apply_each(subinstrumentid, \"lookup(line_base_alloc, subinstrumentid, each)\", {\"subinstrumentid\": subinstrumentid, \"line_base_alloc\": line_base_alloc})\n\n## Iteration\nnoncredit_product_key = apply_each(subinstrumentid, \"if(eq(lookup(line_is_credit, subinstrumentid, each), 1), \\\"__CREDIT__\\\", lookup(line_products, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"line_products\": line_products, \"line_is_credit\": line_is_credit})\n\n## Iteration\nline_ssp_eff = apply_each(subinstrumentid, \"if(eq(lookup(line_is_credit, subinstrumentid, each), 1), lookup(line_ssp_amounts, noncredit_product_key, lookup(line_products, subinstrumentid, each)), lookup(line_ssp_amounts, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"line_products\": line_products, \"line_ssp_amounts\": line_ssp_amounts, \"line_is_credit\": line_is_credit, \"noncredit_product_key\": noncredit_product_key})\n\n## Iteration\nline_group = apply_each(subinstrumentid, \"if(eq(upper(lookup(cat_parent_child, cat_product_u, lookup(line_products_u, subinstrumentid, each))), \\\"CHILD\\\"), upper(lookup(cat_parent_code, cat_product_u, lookup(line_products_u, subinstrumentid, each))), lookup(line_products_u, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"cat_parent_code\": cat_parent_code, \"cat_parent_child\": cat_parent_child, \"cat_product_u\": cat_product_u, \"line_products_u\": line_products_u})\n\n## Iteration\nline_cancelled = apply_each(subinstrumentid, \"if(gt(sum(multiply(multiply(multiply(eq(line_products_u, lookup(line_group, subinstrumentid, each)), line_sale_prices), sub_recip), subtract(1, line_is_credit))), 0.005), if(lt(abs(sum(multiply(multiply(eq(line_products_u, lookup(line_group, subinstrumentid, each)), line_sale_prices), sub_recip))), 0.005), 1, 0), 0)\", {\"subinstrumentid\": subinstrumentid, \"line_products_u\": line_products_u, \"line_sale_prices\": line_sale_prices, \"line_is_credit\": line_is_credit, \"sub_recip\": sub_recip, \"line_group\": line_group})\n\n## Iteration\nprod_recip = apply_each(subinstrumentid, \"divide(1, sum(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), sub_recip)))\", {\"subinstrumentid\": subinstrumentid, \"line_products\": line_products, \"sub_recip\": sub_recip})\n\n## Iteration\ngroup_money = apply_each(subinstrumentid, \"sum(multiply(multiply(eq(line_inv, lookup(line_inv, subinstrumentid, each)), line_sale_prices), sub_recip))\", {\"subinstrumentid\": subinstrumentid, \"line_sale_prices\": line_sale_prices, \"line_inv\": line_inv, \"sub_recip\": sub_recip})\n\n## Iteration\nncred_prod = apply_each(subinstrumentid, \"if(lt(sum(multiply(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), eq(line_inv, lookup(line_inv, subinstrumentid, each))), line_is_credit), sub_recip)), 1), 1, sum(multiply(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), eq(line_inv, lookup(line_inv, subinstrumentid, each))), line_is_credit), sub_recip)))\", {\"subinstrumentid\": subinstrumentid, \"line_products\": line_products, \"line_inv\": line_inv, \"line_is_credit\": line_is_credit, \"sub_recip\": sub_recip})\n\n## Iteration\ncredit_pool_line = apply_each(subinstrumentid, \"sum(multiply(multiply(multiply(eq(line_inv, lookup(line_inv, subinstrumentid, each)), line_is_credit), line_sale_prices), sub_recip))\", {\"subinstrumentid\": subinstrumentid, \"line_sale_prices\": line_sale_prices, \"line_inv\": line_inv, \"line_is_credit\": line_is_credit, \"sub_recip\": sub_recip})\n\n## Iteration\nunit_basis = apply_each(subinstrumentid, \"sum(multiply(multiply(multiply(line_ssp_amounts, prod_recip), sub_recip), subtract(1, line_cancelled)))\", {\"subinstrumentid\": subinstrumentid, \"line_ssp_amounts\": line_ssp_amounts, \"sub_recip\": sub_recip, \"line_cancelled\": line_cancelled, \"prod_recip\": prod_recip})\n\n## Iteration\nunit_money = apply_each(subinstrumentid, \"sum(multiply(multiply(line_sale_prices, sub_recip), subtract(1, line_cancelled)))\", {\"subinstrumentid\": subinstrumentid, \"line_sale_prices\": line_sale_prices, \"sub_recip\": sub_recip, \"line_cancelled\": line_cancelled})\n\n## Iteration\nnot_sp = apply_each(subinstrumentid, \"if(eq(lookup(line_policies, subinstrumentid, each), \\\"SALE_PRICE\\\"), 0, 1)\", {\"subinstrumentid\": subinstrumentid, \"line_policies\": line_policies})\n\nbasis_all = sum(multiply(multiply(multiply(line_ssp_amounts, prod_recip), sub_recip), not_sp))\nmoney_nc = sum(multiply(multiply(line_sale_price_nc, sub_recip), not_sp))\n## Iteration\ncred_ratio = apply_each(subinstrumentid, \"if(eq(lookup(line_is_credit, subinstrumentid, each), 0), 0, if(eq(sum(multiply(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), line_is_credit), group_money), sub_recip)), 0), 0, multiply(sum(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), subtract(1, line_is_credit)), sub_recip)), divide(lookup(group_money, subinstrumentid, each), sum(multiply(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), line_is_credit), group_money), sub_recip))))))\", {\"subinstrumentid\": subinstrumentid, \"line_products\": line_products, \"line_is_credit\": line_is_credit, \"sub_recip\": sub_recip, \"group_money\": group_money})\n\n## Iteration\ncancel_alloc = apply_each(subinstrumentid, \"if(eq(lookup(line_policies, subinstrumentid, each), \\\"SALE_PRICE\\\"), lookup(line_sale_prices, subinstrumentid, each), if(eq(lookup(line_ssp_amounts, subinstrumentid, each), 0), 0, if(eq(basis_all, 0), 0, if(eq(lookup(line_is_credit, subinstrumentid, each), 1), multiply(multiply(divide(lookup(line_ssp_amounts, subinstrumentid, each), basis_all), money_nc), multiply(-1, lookup(cred_ratio, subinstrumentid, each))), multiply(divide(lookup(line_ssp_amounts, subinstrumentid, each), basis_all), money_nc)))))\", {\"subinstrumentid\": subinstrumentid, \"line_sale_prices\": line_sale_prices, \"line_policies\": line_policies, \"line_ssp_amounts\": line_ssp_amounts, \"line_is_credit\": line_is_credit, \"basis_all\": basis_all, \"money_nc\": money_nc, \"cred_ratio\": cred_ratio})\n\n## Iteration\nis_disc = apply_each(subinstrumentid, \"if(eq(lookup(line_products_u, subinstrumentid, each), \\\"DISCOUNT-USD\\\"), 1, 0)\", {\"subinstrumentid\": subinstrumentid, \"line_products_u\": line_products_u})\n\n## Iteration\nlive_recip = apply_each(subinstrumentid, \"multiply(lookup(sub_recip, subinstrumentid, each), subtract(1, lookup(line_cancelled, subinstrumentid, each)))\", {\"subinstrumentid\": subinstrumentid, \"sub_recip\": sub_recip, \"line_cancelled\": line_cancelled})\n\nssp_pool = sum(multiply(multiply(multiply(line_ssp_amounts, prod_recip), live_recip), not_sp))\ndisc_money = sum(multiply(multiply(line_sale_prices, is_disc), live_recip))\nsp_money = sum(multiply(multiply(line_sale_prices, subtract(1, not_sp)), live_recip))\n## Iteration\nline_alloc_raw = apply_each(subinstrumentid, \"if(eq(lookup(line_products_u, subinstrumentid, each), \\\"DISCOUNT-USD\\\"), 0, if(eq(lookup(line_cancelled, subinstrumentid, each), 1), lookup(cancel_alloc, subinstrumentid, each), if(eq(lookup(line_policies, subinstrumentid, each), \\\"SALE_PRICE\\\"), add(lookup(line_sale_prices, subinstrumentid, each), if(eq(ssp_pool, 0), if(eq(sp_money, 0), 0, multiply(disc_money, divide(lookup(line_sale_prices, subinstrumentid, each), sp_money))), 0)), if(eq(lookup(line_ssp_amounts, subinstrumentid, each), 0), 0, if(eq(lookup(unit_basis, subinstrumentid, each), 0), 0, if(eq(lookup(line_is_credit, subinstrumentid, each), 1), multiply(divide(lookup(line_ssp_amounts, subinstrumentid, each), lookup(unit_basis, subinstrumentid, each)), lookup(group_money, subinstrumentid, each)), multiply(divide(lookup(line_ssp_amounts, subinstrumentid, each), lookup(unit_basis, subinstrumentid, each)), subtract(lookup(unit_money, subinstrumentid, each), sum(multiply(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), line_is_credit), group_money), sub_recip))))))))))\", {\"subinstrumentid\": subinstrumentid, \"line_products\": line_products, \"line_products_u\": line_products_u, \"line_sale_prices\": line_sale_prices, \"line_policies\": line_policies, \"line_ssp_amounts\": line_ssp_amounts, \"line_is_credit\": line_is_credit, \"sub_recip\": sub_recip, \"line_cancelled\": line_cancelled, \"group_money\": group_money, \"unit_basis\": unit_basis, \"unit_money\": unit_money, \"cancel_alloc\": cancel_alloc, \"ssp_pool\": ssp_pool, \"disc_money\": disc_money, \"sp_money\": sp_money})\n\n## Iteration\nline_alloc_r = apply_each(subinstrumentid, \"round(lookup(line_alloc_raw, subinstrumentid, each), 4)\", {\"subinstrumentid\": subinstrumentid, \"line_alloc_raw\": line_alloc_raw})\n\ntotal_sale_price_d = sum(multiply(line_sale_price_nc, sub_recip))\nalloc_sum_r = sum(multiply(line_alloc_r, sub_recip))\nalloc_residual = subtract(add(total_sale_price_d, credit_pool_d), alloc_sum_r)\nalloc_max = array_get(line_alloc_r, 0, 0)\nalloc_tied = sum(multiply(eq(line_alloc_r, alloc_max), sub_recip))\n## Iteration\nline_allocated = apply_each(subinstrumentid, \"add(lookup(line_alloc_r, subinstrumentid, each), if(eq(alloc_tied, 0), 0, if(gte(abs(alloc_residual), 0.005), 0, if(eq(lookup(line_alloc_r, subinstrumentid, each), alloc_max), divide(alloc_residual, alloc_tied), 0))))\", {\"subinstrumentid\": subinstrumentid, \"line_alloc_r\": line_alloc_r, \"alloc_residual\": alloc_residual, \"alloc_max\": alloc_max, \"alloc_tied\": alloc_tied})\n\n## Iteration\nline_prior = apply_each(subinstrumentid, \"if(eq(date_diff_days(end_of_month(postingdate), end_of_month(lookup(boarding_month_end, subinstrumentid, each))), 0), 0, 1)\", {\"postingdate\": postingdate, \"subinstrumentid\": subinstrumentid, \"boarding_month_end\": boarding_month_end})\n\nany_new = sum(multiply(subtract(1, line_prior), sub_recip))\n## Iteration\nline_cancelled_p = apply_each(subinstrumentid, \"if(gt(sum(multiply(multiply(multiply(multiply(eq(line_products_u, lookup(line_group, subinstrumentid, each)), line_sale_prices), sub_recip), subtract(1, line_is_credit)), line_prior)), 0.005), if(lt(abs(sum(multiply(multiply(multiply(eq(line_products_u, lookup(line_group, subinstrumentid, each)), line_sale_prices), sub_recip), line_prior))), 0.005), 1, 0), 0)\", {\"subinstrumentid\": subinstrumentid, \"line_products_u\": line_products_u, \"line_sale_prices\": line_sale_prices, \"line_is_credit\": line_is_credit, \"sub_recip\": sub_recip, \"line_group\": line_group, \"line_prior\": line_prior})\n\n## Iteration\nprod_recip_p = apply_each(subinstrumentid, \"if(eq(sum(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), sub_recip), line_prior)), 0), 0, divide(1, sum(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), sub_recip), line_prior))))\", {\"subinstrumentid\": subinstrumentid, \"line_products\": line_products, \"sub_recip\": sub_recip, \"line_prior\": line_prior})\n\nunit_basis_p = sum(multiply(multiply(multiply(multiply(line_ssp_amounts, prod_recip_p), sub_recip), subtract(1, line_cancelled_p)), line_prior))\nunit_money_p = sum(multiply(multiply(multiply(line_sale_prices, sub_recip), subtract(1, line_cancelled_p)), line_prior))\nbasis_all_p = sum(multiply(multiply(multiply(multiply(line_ssp_amounts, prod_recip_p), sub_recip), line_prior), not_sp))\nmoney_nc_p = sum(multiply(multiply(multiply(line_sale_price_nc, sub_recip), line_prior), not_sp))\n## Iteration\ncredit_prior = apply_each(subinstrumentid, \"multiply(lookup(line_is_credit, subinstrumentid, each), lookup(line_prior, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"line_is_credit\": line_is_credit, \"line_prior\": line_prior})\n\n## Iteration\nnoncredit_prior = apply_each(subinstrumentid, \"multiply(subtract(1, lookup(line_is_credit, subinstrumentid, each)), lookup(line_prior, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"line_is_credit\": line_is_credit, \"line_prior\": line_prior})\n\n## Iteration\ncred_ratio_p = apply_each(subinstrumentid, \"if(eq(lookup(credit_prior, subinstrumentid, each), 0), 0, if(eq(sum(multiply(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), credit_prior), group_money), sub_recip)), 0), 0, multiply(sum(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), noncredit_prior), sub_recip)), divide(lookup(group_money, subinstrumentid, each), sum(multiply(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), credit_prior), group_money), sub_recip))))))\", {\"subinstrumentid\": subinstrumentid, \"line_products\": line_products, \"sub_recip\": sub_recip, \"group_money\": group_money, \"credit_prior\": credit_prior, \"noncredit_prior\": noncredit_prior})\n\n## Iteration\ncancel_alloc_p = apply_each(subinstrumentid, \"if(eq(lookup(line_policies, subinstrumentid, each), \\\"SALE_PRICE\\\"), lookup(line_sale_prices, subinstrumentid, each), if(eq(lookup(line_ssp_amounts, subinstrumentid, each), 0), 0, if(eq(basis_all_p, 0), 0, if(eq(lookup(line_is_credit, subinstrumentid, each), 1), multiply(multiply(divide(lookup(line_ssp_amounts, subinstrumentid, each), basis_all_p), money_nc_p), multiply(-1, lookup(cred_ratio_p, subinstrumentid, each))), multiply(divide(lookup(line_ssp_amounts, subinstrumentid, each), basis_all_p), money_nc_p)))))\", {\"subinstrumentid\": subinstrumentid, \"line_sale_prices\": line_sale_prices, \"line_policies\": line_policies, \"line_ssp_amounts\": line_ssp_amounts, \"line_is_credit\": line_is_credit, \"basis_all_p\": basis_all_p, \"money_nc_p\": money_nc_p, \"cred_ratio_p\": cred_ratio_p})\n\n## Iteration\ngroup_money_prior = apply_each(subinstrumentid, \"multiply(lookup(group_money, subinstrumentid, each), lookup(line_prior, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"group_money\": group_money, \"line_prior\": line_prior})\n\n## Iteration\ncred_money_p = apply_each(subinstrumentid, \"sum(multiply(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), line_is_credit), group_money_prior), sub_recip))\", {\"subinstrumentid\": subinstrumentid, \"line_products\": line_products, \"line_is_credit\": line_is_credit, \"sub_recip\": sub_recip, \"group_money_prior\": group_money_prior})\n\n## Iteration\nlive_recip_p = apply_each(subinstrumentid, \"multiply(multiply(lookup(sub_recip, subinstrumentid, each), subtract(1, lookup(line_cancelled_p, subinstrumentid, each))), lookup(line_prior, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"sub_recip\": sub_recip, \"line_prior\": line_prior, \"line_cancelled_p\": line_cancelled_p})\n\nssp_pool_p = sum(multiply(multiply(multiply(line_ssp_amounts, prod_recip_p), live_recip_p), not_sp))\ndisc_money_p = sum(multiply(multiply(line_sale_prices, is_disc), live_recip_p))\nsp_money_p = sum(multiply(multiply(line_sale_prices, subtract(1, not_sp)), live_recip_p))\n## Iteration\nline_alloc_raw_p = apply_each(subinstrumentid, \"if(eq(lookup(line_prior, subinstrumentid, each), 0), 0, if(eq(lookup(line_products_u, subinstrumentid, each), \\\"DISCOUNT-USD\\\"), 0, if(eq(lookup(line_cancelled_p, subinstrumentid, each), 1), lookup(cancel_alloc_p, subinstrumentid, each), if(eq(lookup(line_policies, subinstrumentid, each), \\\"SALE_PRICE\\\"), add(lookup(line_sale_prices, subinstrumentid, each), if(eq(ssp_pool_p, 0), if(eq(sp_money_p, 0), 0, multiply(disc_money_p, divide(lookup(line_sale_prices, subinstrumentid, each), sp_money_p))), 0)), if(eq(lookup(line_ssp_amounts, subinstrumentid, each), 0), 0, if(eq(unit_basis_p, 0), 0, if(eq(lookup(line_is_credit, subinstrumentid, each), 1), multiply(divide(lookup(line_ssp_amounts, subinstrumentid, each), unit_basis_p), lookup(group_money, subinstrumentid, each)), multiply(divide(lookup(line_ssp_amounts, subinstrumentid, each), unit_basis_p), subtract(unit_money_p, lookup(cred_money_p, subinstrumentid, each))))))))))\", {\"subinstrumentid\": subinstrumentid, \"line_products_u\": line_products_u, \"line_sale_prices\": line_sale_prices, \"line_policies\": line_policies, \"line_ssp_amounts\": line_ssp_amounts, \"line_is_credit\": line_is_credit, \"group_money\": group_money, \"line_prior\": line_prior, \"line_cancelled_p\": line_cancelled_p, \"unit_basis_p\": unit_basis_p, \"unit_money_p\": unit_money_p, \"cancel_alloc_p\": cancel_alloc_p, \"cred_money_p\": cred_money_p, \"ssp_pool_p\": ssp_pool_p, \"disc_money_p\": disc_money_p, \"sp_money_p\": sp_money_p})\n\n## Iteration\nline_alloc_r_p = apply_each(subinstrumentid, \"round(lookup(line_alloc_raw_p, subinstrumentid, each), 4)\", {\"subinstrumentid\": subinstrumentid, \"line_alloc_raw_p\": line_alloc_raw_p})\n\nalloc_residual_p = subtract(add(sum(multiply(multiply(line_sale_price_nc, sub_recip), line_prior)), sum(multiply(multiply(multiply(line_sale_prices, line_is_credit), sub_recip), line_prior))), sum(multiply(line_alloc_r_p, sub_recip)))\nalloc_max_p = array_get(line_alloc_r_p, 0, 0)\nalloc_tied_p = sum(multiply(multiply(eq(line_alloc_r_p, alloc_max_p), sub_recip), line_prior))\n## Iteration\nline_allocated_p = apply_each(subinstrumentid, \"multiply(lookup(line_prior, subinstrumentid, each), add(lookup(line_alloc_r_p, subinstrumentid, each), if(eq(alloc_tied_p, 0), 0, if(gte(abs(alloc_residual_p), 0.005), 0, if(eq(lookup(line_alloc_r_p, subinstrumentid, each), alloc_max_p), divide(alloc_residual_p, alloc_tied_p), 0)))))\", {\"subinstrumentid\": subinstrumentid, \"line_prior\": line_prior, \"line_alloc_r_p\": line_alloc_r_p, \"alloc_residual_p\": alloc_residual_p, \"alloc_max_p\": alloc_max_p, \"alloc_tied_p\": alloc_tied_p})\n\n## Iteration\nalloc_delta = apply_each(subinstrumentid, \"if(eq(lookup(line_prior, subinstrumentid, each), 0), 0, if(eq(any_new, 0), 0, round(subtract(lookup(line_allocated, subinstrumentid, each), lookup(line_allocated_p, subinstrumentid, each)), 4)))\", {\"subinstrumentid\": subinstrumentid, \"line_allocated\": line_allocated, \"line_prior\": line_prior, \"any_new\": any_new, \"line_allocated_p\": line_allocated_p})\n\n## Iteration\nline_balance = apply_each(subinstrumentid, \"sum(multiply(eq(bal_subids, each), bal_amounts))\", {\"subinstrumentid\": subinstrumentid, \"bal_subids\": bal_subids, \"bal_amounts\": bal_amounts})\n\nbal_postings = collect_by_instrument('REVENUE_BALANCE_postingdate')\nstale_balance_error = if(eq(array_length(bal_postings), 0), 0, if(eq(date_diff_days(array_get(bal_postings, 0, postingdate), postingdate), 0), 0, 1))\n## Iteration\nbalance_row_count = apply_each(subinstrumentid, \"sum(eq(bal_subids, each))\", {\"subinstrumentid\": subinstrumentid, \"bal_subids\": bal_subids})\n\nbalance_alignment_error = if(gt(sum(balance_row_count), array_length(bal_subids)), 1, 0)\n## Iteration\nprod_nc_count = apply_each(subinstrumentid, \"sum(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), subtract(1, line_is_credit)), sub_recip))\", {\"subinstrumentid\": subinstrumentid, \"line_products\": line_products, \"line_is_credit\": line_is_credit, \"sub_recip\": sub_recip})\n\n## Iteration\nprod_alloc_sum = apply_each(subinstrumentid, \"sum(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), line_allocated), sub_recip))\", {\"subinstrumentid\": subinstrumentid, \"line_products\": line_products, \"sub_recip\": sub_recip, \"line_allocated\": line_allocated})\n\n## Iteration\nprod_bal_sum = apply_each(subinstrumentid, \"sum(multiply(multiply(eq(line_products, lookup(line_products, subinstrumentid, each)), line_balance), sub_recip))\", {\"subinstrumentid\": subinstrumentid, \"line_products\": line_products, \"sub_recip\": sub_recip, \"line_balance\": line_balance})\n\n## Iteration\ncur_delivery_amount = apply_each(subinstrumentid, \"if(eq(lookup(line_is_credit, subinstrumentid, each), 1), 0, if(eq(lookup(prod_nc_count, subinstrumentid, each), 0), 0, if(gt(multiply(lookup(cur_delivery_units, subinstrumentid, each), divide(lookup(prod_alloc_sum, subinstrumentid, each), lookup(prod_nc_count, subinstrumentid, each))), if(lt(divide(add(lookup(prod_alloc_sum, subinstrumentid, each), lookup(prod_bal_sum, subinstrumentid, each)), lookup(prod_nc_count, subinstrumentid, each)), 0), 0, divide(add(lookup(prod_alloc_sum, subinstrumentid, each), lookup(prod_bal_sum, subinstrumentid, each)), lookup(prod_nc_count, subinstrumentid, each)))), if(lt(divide(add(lookup(prod_alloc_sum, subinstrumentid, each), lookup(prod_bal_sum, subinstrumentid, each)), lookup(prod_nc_count, subinstrumentid, each)), 0), 0, divide(add(lookup(prod_alloc_sum, subinstrumentid, each), lookup(prod_bal_sum, subinstrumentid, each)), lookup(prod_nc_count, subinstrumentid, each))), multiply(lookup(cur_delivery_units, subinstrumentid, each), divide(lookup(prod_alloc_sum, subinstrumentid, each), lookup(prod_nc_count, subinstrumentid, each))))))\", {\"subinstrumentid\": subinstrumentid, \"cur_delivery_units\": cur_delivery_units, \"line_is_credit\": line_is_credit, \"prod_nc_count\": prod_nc_count, \"prod_alloc_sum\": prod_alloc_sum, \"prod_bal_sum\": prod_bal_sum})\n\n## Iteration\nline_remaining = apply_each(subinstrumentid, \"if(eq(lookup(line_methods, subinstrumentid, each), \\\"PROPORTIONAL_PERFORMANCE\\\"), subtract(add(lookup(line_allocated, subinstrumentid, each), lookup(line_balance, subinstrumentid, each)), lookup(cur_delivery_amount, subinstrumentid, each)), if(gte(lookup(line_allocated, subinstrumentid, each), 0), max(subtract(lookup(line_allocated, subinstrumentid, each), lookup(line_balance, subinstrumentid, each)), 0), min(subtract(lookup(line_allocated, subinstrumentid, each), lookup(line_balance, subinstrumentid, each)), 0)))\", {\"subinstrumentid\": subinstrumentid, \"line_methods\": line_methods, \"line_allocated\": line_allocated, \"line_balance\": line_balance, \"cur_delivery_amount\": cur_delivery_amount})\n\n## Iteration\nline_po_days = apply_each(subinstrumentid, \"add(date_diff_days(lookup(line_starts, subinstrumentid, each), lookup(line_ends, subinstrumentid, each)), 1)\", {\"subinstrumentid\": subinstrumentid, \"line_starts\": line_starts, \"line_ends\": line_ends})\n\n## Iteration\nline_per_day = apply_each(subinstrumentid, \"if(eq(lookup(line_po_days, subinstrumentid, each), 0), 0, divide(lookup(line_allocated, subinstrumentid, each), lookup(line_po_days, subinstrumentid, each)))\", {\"subinstrumentid\": subinstrumentid, \"line_allocated\": line_allocated, \"line_po_days\": line_po_days})\n\n## Iteration\nline_is_ratable = apply_each(subinstrumentid, \"if(eq(lookup(line_methods, subinstrumentid, each), \\\"RATABLE\\\"), 1, 0)\", {\"subinstrumentid\": subinstrumentid, \"line_methods\": line_methods})\n\n## Iteration\nline_is_pit = apply_each(subinstrumentid, \"if(eq(lookup(line_methods, subinstrumentid, each), \\\"POINT_IN_TIME\\\"), 1, 0)\", {\"subinstrumentid\": subinstrumentid, \"line_methods\": line_methods})\n\n## Iteration\nline_is_prop = apply_each(subinstrumentid, \"if(eq(lookup(line_methods, subinstrumentid, each), \\\"PROPORTIONAL_PERFORMANCE\\\"), 1, 0)\", {\"subinstrumentid\": subinstrumentid, \"line_methods\": line_methods})\n\n## Iteration\nline_ends_eom = apply_each(subinstrumentid, \"end_of_month(lookup(line_ends, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"line_ends\": line_ends})\n\n## Schedule\np = period(line_starts, line_ends_eom, \"M\")\nrev_schedule = schedule(p, {\n    \"period_date\": \"period_date\",\n    \"month_end\": \"end_of_month(period_date)\",\n    \"days_in_month\": \"add(date_diff_days(if(gt(date_diff_days(start_of_month(month_end), line_starts), 0), line_starts, start_of_month(month_end)), if(gt(date_diff_days(line_ends, month_end), 0), line_ends, month_end)), 1)\",\n    \"period_no\": \"add(period_index, 1)\",\n    \"prior_ltd_days\": \"date_diff_days(line_starts, start_of_month(month_end))\",\n    \"is_last\": \"if(eq(date_diff_days(month_end, end_of_month(line_ends)), 0), 1, 0)\",\n    \"gross_calc\": \"if(eq(line_is_ratable, 1), multiply(line_per_day, days_in_month), if(eq(line_is_pit, 1), if(eq(date_diff_days(month_end, end_of_month(line_starts)), 0), line_allocated, 0), if(eq(line_is_prop, 1), if(eq(is_last, 1), line_remaining, 0), if(eq(is_last, 1), line_allocated, 0))))\",\n    \"cum_prior\": \"lag('ltd_gross', 1, 0)\",\n    \"gross_revenue\": \"if(eq(multiply(is_last, line_is_ratable), 1), subtract(line_allocated, cum_prior), gross_calc)\",\n    \"boarding_me\": \"end_of_month(boarding_month_end)\",\n    \"pre_gross\": \"if(gt(date_diff_days(month_end, boarding_me), 0), gross_revenue, 0)\",\n    \"cum_pre\": \"add(lag('cum_pre', 1, 0), pre_gross)\",\n    \"revenue_ppa\": \"round(if(eq(date_diff_days(month_end, boarding_me), 0), lag('cum_pre', 1, 0), 0), 4)\",\n    \"revenue\": \"if(lte(date_diff_days(month_end, boarding_me), 0), gross_revenue, 0)\",\n    \"ltd_gross\": \"add(lag('ltd_gross', 1, 0), gross_revenue)\"\n}, {\"boarding_month_end\": boarding_month_end, \"line_allocated\": line_allocated, \"line_ends\": line_ends, \"line_is_pit\": line_is_pit, \"line_is_prop\": line_is_prop, \"line_is_ratable\": line_is_ratable, \"line_per_day\": line_per_day, \"line_remaining\": line_remaining, \"line_starts\": line_starts, \"item_names\": line_products})\nrev_now = schedule_filter(rev_schedule, \"month_end\", postingdate, \"revenue\")\nppa_now = schedule_filter(rev_schedule, \"month_end\", postingdate, \"revenue_ppa\")\nposted_rev_total = schedule_sum(rev_schedule, \"revenue\")\nltd_close = schedule_last(rev_schedule, \"ltd_gross\")\n\n## Iteration\nppa_amount = apply_each(subinstrumentid, \"round(lookup(ppa_now, subinstrumentid, each), 4)\", {\"subinstrumentid\": subinstrumentid, \"ppa_now\": ppa_now})\n\n## Iteration\nlate_credit_ppa = apply_each(subinstrumentid, \"if(gt(multiply(gt(date_diff_days(end_of_month(lookup(line_ends, subinstrumentid, each)), end_of_month(lookup(boarding_month_end, subinstrumentid, each))), 0), eq(date_diff_days(end_of_month(postingdate), end_of_month(lookup(boarding_month_end, subinstrumentid, each))), 0)), 0), lookup(line_allocated, subinstrumentid, each), 0)\", {\"postingdate\": postingdate, \"subinstrumentid\": subinstrumentid, \"line_ends\": line_ends, \"boarding_month_end\": boarding_month_end, \"line_allocated\": line_allocated})\n\n## Iteration\nrat_target = apply_each(subinstrumentid, \"if(lte(lookup(line_po_days, subinstrumentid, each), 0), 0, if(lt(add(date_diff_days(lookup(line_starts, subinstrumentid, each), if(gt(date_diff_days(lookup(line_ends, subinstrumentid, each), end_of_month(postingdate)), 0), lookup(line_ends, subinstrumentid, each), end_of_month(postingdate))), 1), 0), 0, multiply(lookup(line_allocated, subinstrumentid, each), divide(add(date_diff_days(lookup(line_starts, subinstrumentid, each), if(gt(date_diff_days(lookup(line_ends, subinstrumentid, each), end_of_month(postingdate)), 0), lookup(line_ends, subinstrumentid, each), end_of_month(postingdate))), 1), lookup(line_po_days, subinstrumentid, each)))))\", {\"postingdate\": postingdate, \"subinstrumentid\": subinstrumentid, \"line_starts\": line_starts, \"line_ends\": line_ends, \"line_allocated\": line_allocated, \"line_po_days\": line_po_days})\n\n## Iteration\nrev_amount = apply_each(subinstrumentid, \"if(gt(multiply(multiply(eq(lookup(line_is_ratable, subinstrumentid, each), 1), eq(date_diff_days(end_of_month(postingdate), end_of_month(lookup(line_ends, subinstrumentid, each))), 0)), gt(array_length(bal_subids), 0)), 0), subtract(add(lookup(line_allocated, subinstrumentid, each), lookup(line_balance, subinstrumentid, each)), lookup(ppa_amount, subinstrumentid, each)), if(gt(multiply(multiply(multiply(eq(lookup(line_is_ratable, subinstrumentid, each), 1), gt(date_diff_days(end_of_month(lookup(boarding_month_end, subinstrumentid, each)), end_of_month(postingdate)), 0)), gt(array_length(bal_subids), 0)), gt(abs(lookup(alloc_delta, subinstrumentid, each)), 0.00005)), 0), round(add(lookup(rat_target, subinstrumentid, each), lookup(line_balance, subinstrumentid, each)), 4), lookup(rev_now, subinstrumentid, each)))\", {\"postingdate\": postingdate, \"subinstrumentid\": subinstrumentid, \"line_ends\": line_ends, \"bal_subids\": bal_subids, \"boarding_month_end\": boarding_month_end, \"line_allocated\": line_allocated, \"alloc_delta\": alloc_delta, \"line_balance\": line_balance, \"line_is_ratable\": line_is_ratable, \"rev_now\": rev_now, \"ppa_amount\": ppa_amount, \"rat_target\": rat_target})\n\nrecon_difference = subtract(posted_rev_total, line_allocated)\n## Iteration\nper_line_credit_err = apply_each(subinstrumentid, \"if(eq(lookup(line_is_credit, subinstrumentid, each), 1), if(gt(abs(add(lookup(line_sale_prices, subinstrumentid, each), lookup(line_sale_prices, noncredit_product_key, lookup(line_products, subinstrumentid, each)))), 0.005), 1, 0), 0)\", {\"subinstrumentid\": subinstrumentid, \"line_products\": line_products, \"line_sale_prices\": line_sale_prices, \"line_is_credit\": line_is_credit, \"noncredit_product_key\": noncredit_product_key})\n\ncredit_amount_error = if(gt(sum(per_line_credit_err), 0), 1, 0)\n## Iteration\nratable_adj_ppa = apply_each(subinstrumentid, \"if(gt(multiply(multiply(multiply(eq(lookup(line_is_ratable, subinstrumentid, each), 1), eq(date_diff_days(end_of_month(postingdate), end_of_month(lookup(line_ends, subinstrumentid, each))), 0)), gt(array_length(bal_subids), 0)), gt(abs(subtract(subtract(add(lookup(line_allocated, subinstrumentid, each), lookup(line_balance, subinstrumentid, each)), lookup(rev_amount, subinstrumentid, each)), lookup(ppa_amount, subinstrumentid, each))), 0.005)), 0), subtract(subtract(add(lookup(line_allocated, subinstrumentid, each), lookup(line_balance, subinstrumentid, each)), lookup(rev_amount, subinstrumentid, each)), lookup(ppa_amount, subinstrumentid, each)), 0)\", {\"postingdate\": postingdate, \"subinstrumentid\": subinstrumentid, \"line_ends\": line_ends, \"bal_subids\": bal_subids, \"line_allocated\": line_allocated, \"line_balance\": line_balance, \"line_is_ratable\": line_is_ratable, \"ppa_amount\": ppa_amount, \"rev_amount\": rev_amount})\n\n## Iteration\nppa_amount_neg = apply_each(subinstrumentid, \"round(multiply(add(add(lookup(ppa_amount, subinstrumentid, each), lookup(late_credit_ppa, subinstrumentid, each)), lookup(ratable_adj_ppa, subinstrumentid, each)), -1), 4)\", {\"subinstrumentid\": subinstrumentid, \"ppa_amount\": ppa_amount, \"late_credit_ppa\": late_credit_ppa, \"ratable_adj_ppa\": ratable_adj_ppa})\n\n## Iteration\ncn_now_r = apply_each(subinstrumentid, \"if(gt(multiply(eq(lookup(line_is_credit, subinstrumentid, each), 1), eq(date_diff_days(end_of_month(lookup(boarding_month_end, subinstrumentid, each)), end_of_month(postingdate)), 0)), 0), lookup(line_sale_prices, subinstrumentid, each), 0)\", {\"postingdate\": postingdate, \"subinstrumentid\": subinstrumentid, \"line_sale_prices\": line_sale_prices, \"boarding_month_end\": boarding_month_end, \"line_is_credit\": line_is_credit})\n\n## Iteration\npit_adj = apply_each(subinstrumentid, \"if(gt(date_diff_days(end_of_month(lookup(line_starts, subinstrumentid, each)), end_of_month(postingdate)), 0), lookup(alloc_delta, subinstrumentid, each), 0)\", {\"postingdate\": postingdate, \"subinstrumentid\": subinstrumentid, \"line_starts\": line_starts, \"alloc_delta\": alloc_delta})\n\n## Iteration\nrev_amount_neg = apply_each(subinstrumentid, \"add(round(if(gt(multiply(multiply(eq(lookup(line_methods, subinstrumentid, each), \\\"PROPORTIONAL_PERFORMANCE\\\"), subtract(1, lookup(line_is_credit, subinstrumentid, each))), gt(lookup(line_allocated, subinstrumentid, each), 0)), 0), if(gt(multiply(lookup(rev_amount, subinstrumentid, each), -1), 0), 0, multiply(lookup(rev_amount, subinstrumentid, each), -1)), multiply(lookup(rev_amount, subinstrumentid, each), -1)), 4), if(eq(lookup(line_methods, subinstrumentid, each), \\\"POINT_IN_TIME\\\"), round(multiply(lookup(pit_adj, subinstrumentid, each), -1), 4), 0))\", {\"subinstrumentid\": subinstrumentid, \"line_methods\": line_methods, \"line_is_credit\": line_is_credit, \"line_allocated\": line_allocated, \"rev_amount\": rev_amount, \"pit_adj\": pit_adj})\n\n## Iteration\ncn_now = apply_each(subinstrumentid, \"if(gt(multiply(eq(lookup(line_is_credit, subinstrumentid, each), 1), eq(date_diff_days(end_of_month(lookup(boarding_month_end, subinstrumentid, each)), end_of_month(postingdate)), 0)), 0), lookup(line_sale_prices, subinstrumentid, each), 0)\", {\"postingdate\": postingdate, \"subinstrumentid\": subinstrumentid, \"line_sale_prices\": line_sale_prices, \"boarding_month_end\": boarding_month_end, \"line_is_credit\": line_is_credit})\n\n## Iteration\nalloc_adj = apply_each(subinstrumentid, \"lookup(alloc_delta, subinstrumentid, each)\", {\"subinstrumentid\": subinstrumentid, \"alloc_delta\": alloc_delta})\n\n## Iteration\nalloc_booked = apply_each(subinstrumentid, \"add(if(eq(date_diff_days(end_of_month(postingdate), end_of_month(lookup(boarding_month_end, subinstrumentid, each))), 0), lookup(line_allocated, subinstrumentid, each), 0), lookup(alloc_adj, subinstrumentid, each))\", {\"postingdate\": postingdate, \"subinstrumentid\": subinstrumentid, \"boarding_month_end\": boarding_month_end, \"line_allocated\": line_allocated, \"alloc_adj\": alloc_adj})\n\nalloc_residual_error = if(gt(abs(alloc_residual), 0.005), 1, 0)\n\n## Create Transactions\ncreateTransaction(postingdate, effectivedate, \"Revenue\", rev_amount_neg, subinstrumentid)\ncreateTransaction(postingdate, effectivedate, \"Revenue_PPA\", ppa_amount_neg, subinstrumentid)\ncreateTransaction(postingdate, effectivedate, \"ALLOCATED_REVENUE\", alloc_booked, subinstrumentid)",
