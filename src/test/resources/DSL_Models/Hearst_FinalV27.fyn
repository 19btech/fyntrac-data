            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "line_sub_ids",
                "varName": "each",
                "expression": "if(eq(lookup(d_is_credit, line_sub_ids, each), 1), 0, if(eq(lookup(d_cancel, line_sub_ids, each), 1), 0, if(eq(lookup(d_nc_count, line_sub_ids, each), 0), 0, divide(if(eq(lookup(d_policy, line_sub_ids, each), \"SALE_PRICE\"), lookup(d_prod_money, line_sub_ids, each), if(eq(d_basis, 0), 0, multiply(divide(lookup(d_ssp, line_sub_ids, each), d_basis), d_money))), lookup(d_nc_count, line_sub_ids, each)))))",
                "resultVar": "d_sub_net"
              }
            ],
            "commentText": "net allocation of this line's product (all its subs incl. credit notes), split over the product's non-credit lines"
          },
