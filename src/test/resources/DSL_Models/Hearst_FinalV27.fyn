          },
          {
            "id": "21e0365c-7e01-4343-9bc6-3769bffa3fd8",
            "name": "line_sale_prices",
            "stepType": "calc",
            "source": "formula",
            "formula": "collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_SALE_PRICE_CURRENT')",
            "value": "",
            "eventField": "",
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "6376b334-6123-4363-b9c5-b843bb72b2ec",
            "name": "line_postings",
            "stepType": "calc",
            "source": "formula",
            "formula": "collect_by_instrument('SALE_ORDER_DETAILS_postingdate')",
            "value": "",
            "eventField": "",
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "5fa5c76b-c0d5-4415-952b-f72608957e46",
            "name": "boarding_month_end",
            "stepType": "calc",
            "source": "formula",
            "formula": "end_of_month(array_get(line_postings, 0, postingdate))",
            "value": "",
            "eventField": "",
            "printResult": false,
            "inlineComment": false,
            "commentText": ""
          },
          {
            "id": "88987263-e199-42d7-9532-3067daba68dd",
            "name": "line_policies",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "lookup(cat_policy, cat_product, each)",
                "resultVar": "line_policies",
                "sourceArray": "line_products",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "a47132ae-5a38-41d1-b730-dac821258636",
            "name": "line_ssp_dollar",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "lookup(cat_ssp_amount, cat_product, each)",
                "resultVar": "line_ssp_dollar",
                "sourceArray": "line_products",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "f9a69f7f-0b6f-45cd-bc9e-9c39cad629e0",
            "name": "line_ssp_amounts",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_policies, line_products, each), \"DOLLAR_AMOUNT\"), lookup(line_ssp_dollar, line_products, each), lookup(line_sale_prices, line_products, each))",
                "resultVar": "line_ssp_amounts",
                "sourceArray": "line_products",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "f1c419da-6209-49b1-8cc5-e9576755f77b",
            "name": "line_inv",
            "stepType": "calc",
            "source": "formula",
            "formula": "collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_INVOICE_NUMBER_CURRENT')",
            "value": "",
            "eventField": "",
            "collectType": "collect_by_instrument"
          },
          {
            "id": "01f01a37-4cd7-41a6-8020-2d3127fd1adc",
            "name": "line_refinv",
            "stepType": "calc",
            "source": "formula",
            "formula": "collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_REFERENCE_INVOICE_NUMBER_CURRENT')",
            "value": "",
            "eventField": "",
            "collectType": "collect_by_instrument"
          },
          {
            "id": "6f5ae4fa-e21e-4c7f-88f1-a7d0531ed50a",
            "name": "line_is_credit",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(neq(lookup(line_inv, line_sub_ids, each), lookup(line_refinv, line_sub_ids, each)), 1, 0)",
                "resultVar": "line_is_credit",
                "sourceArray": "line_sub_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "7ae0681b-42b4-41e1-ae34-11b407430b90",
            "name": "line_sale_price_nc",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "multiply(lookup(line_sale_prices, line_sub_ids, each), subtract(1, lookup(line_is_credit, line_sub_ids, each)))",
                "resultVar": "line_sale_price_nc",
                "sourceArray": "line_sub_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "55ef493c-be73-4ba1-83da-42ca72a9550f",
            "name": "line_ssp_nc",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "multiply(lookup(line_ssp_amounts, line_sub_ids, each), subtract(1, lookup(line_is_credit, line_sub_ids, each)))",
                "resultVar": "line_ssp_nc",
                "sourceArray": "line_sub_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "72acce17-da39-446b-aa3c-fffcd36a1905",
            "name": "total_sale_price",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(line_sale_price_nc)",
            "value": "",
            "eventField": "",
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "c839b1fe-5bda-4a59-a88d-873018a80002",
            "name": "total_ssp",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(line_ssp_nc)",
            "value": "",
            "eventField": "",
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "44effa04-b214-499f-92d3-5566d4139ce1",
            "name": "line_ratios",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(total_ssp, 0), 0, divide(lookup(line_ssp_amounts, line_sub_ids, each), total_ssp))",
                "resultVar": "line_ratios",
                "sourceArray": "line_sub_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "96d349f7-56bc-4d08-8502-43a90a2f685e",
            "name": "sub_recip",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "divide(1, sum(eq(line_sub_ids, each)))",
                "resultVar": "sub_recip",
                "sourceArray": "line_sub_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "7b97245e-30ea-421b-a0ec-e7834bd644bf",
            "name": "distinct_prod_count",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(sub_recip)",
            "value": "",
            "eventField": ""
          },
          {
            "id": "a6fc7a8d-1297-4c5e-af5d-b8640a6d43f3",
            "name": "line_base_alloc",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "round(multiply(lookup(line_ratios, line_sub_ids, each), total_sale_price), 4)",
                "resultVar": "line_base_alloc",
                "sourceArray": "line_sub_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "ea6e59a3-ff9f-408a-b699-4152f1b9507f",
            "name": "line_base_alloc_adj",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(gt(multiply(multiply(eq(total_ssp, 0), eq(distinct_prod_count, 1)), eq(lookup(line_ssp_amounts, line_sub_ids, each), 0)), 0), lookup(line_sale_prices, line_sub_ids, each), lookup(line_base_alloc, line_sub_ids, each))",
                "resultVar": "line_base_alloc_adj",
                "sourceArray": "line_sub_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "4b5fbd7f-033a-4250-94a6-fedf144e0194",
            "name": "noncredit_product_key",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_is_credit, line_sub_ids, each), 1), \"__CREDIT__\", lookup(line_products, line_sub_ids, each))",
                "resultVar": "noncredit_product_key",
                "sourceArray": "line_sub_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "066a26e0-4f79-4c9c-a73b-a4eaae2f187c",
            "name": "line_allocated",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_is_credit, line_sub_ids, each), 1), subtract(0, lookup(line_base_alloc_adj, noncredit_product_key, lookup(line_products, line_sub_ids, each))), lookup(line_base_alloc_adj, line_sub_ids, each))",
                "resultVar": "line_allocated",
                "sourceArray": "line_sub_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "003f3da8-e103-449e-a731-cd4dc5988784",
            "name": "allocated_for_line",
            "stepType": "calc",
            "source": "formula",
            "formula": "lookup(line_allocated, line_sub_ids, this_sub)",
            "value": "",
            "eventField": "",
            "printResult": false,
            "inlineComment": false,
            "commentText": ""
          },
          {
            "id": "d18f1bc4-f76e-4ce4-9f98-18c48f0ac31a",
            "name": "cat_product_u",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "cat_product",
                "varName": "each",
                "expression": "upper(each)",
                "resultVar": "cat_product_u"
              }
            ]
          },
          {
            "id": "6bfd35fe-e334-4ed7-89b9-06edc64ed695",
            "name": "cat_parent_code",
            "stepType": "calc",
            "source": "formula",
            "formula": "collect_all('SSP_RULE_parent_code')",
            "value": "",
            "eventField": ""
          },
          {
            "id": "c2ecd54f-4b84-4fe3-a461-574cf74a7876",
            "name": "cat_parent_child",
            "stepType": "calc",
            "source": "formula",
            "formula": "collect_all('SSP_RULE_parent_child')",
            "value": "",
            "eventField": ""
          },
          {
            "id": "999e2e64-6b1d-4e45-871b-2f3eac8b4adf",
            "name": "d_prod",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "line_sub_ids",
                "varName": "each",
                "expression": "upper(lookup(line_products, line_sub_ids, each))",
                "resultVar": "d_prod"
              }
            ],
            "commentText": "net-allocation chain (mirrors REVREC_Revenue_Recognition) so deliveries recognise against the product's NET allocation, credits included"
          },
          {
            "id": "b8774a5e-741e-41c7-ba33-7bf9fd24610f",
            "name": "d_is_credit",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "line_sub_ids",
                "varName": "each",
                "expression": "if(eq(lookup(d_prod, line_sub_ids, each), \"DISCOUNT-USD\"), 0, if(lt(lookup(line_sale_prices, line_sub_ids, each), 0), 1, if(eq(lookup(line_sale_prices, line_sub_ids, each), 0), if(lt(sum(multiply(eq(line_inv, lookup(line_inv, line_sub_ids, each)), line_sale_prices)), 0), 1, 0), 0)))",
                "resultVar": "d_is_credit"
              }
            ]
          },
          {
            "id": "37e8678a-f8d9-462b-a6ff-3c90b9f642e7",
            "name": "d_policy",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "line_sub_ids",
                "varName": "each",
                "expression": "lookup(cat_policy, cat_product_u, lookup(d_prod, line_sub_ids, each))",
                "resultVar": "d_policy"
              }
            ]
          },
          {
            "id": "fce190ac-6c17-435c-bb5d-7da1356f5eb7",
            "name": "d_ssp_raw",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "line_sub_ids",
                "varName": "each",
                "expression": "if(eq(lookup(d_prod, line_sub_ids, each), \"DISCOUNT-USD\"), 0, if(eq(lookup(d_policy, line_sub_ids, each), \"DOLLAR_AMOUNT\"), lookup(cat_ssp_amount, cat_product_u, lookup(d_prod, line_sub_ids, each)), lookup(line_sale_prices, line_sub_ids, each)))",
                "resultVar": "d_ssp_raw"
              }
            ]
          },
          {
            "id": "2aff469f-d2b6-4138-be42-dbe2867c72ae",
            "name": "d_ssp_total",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(d_ssp_raw)",
            "value": "",
            "eventField": ""
          },
          {
            "id": "6bc32276-e847-4ca2-867d-e01a867fc8c0",
            "name": "d_ssp",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "line_sub_ids",
                "varName": "each",
                "expression": "if(eq(lookup(d_prod, line_sub_ids, each), \"DISCOUNT-USD\"), 0, if(eq(d_ssp_total, 0), abs(lookup(line_sale_prices, line_sub_ids, each)), lookup(d_ssp_raw, line_sub_ids, each)))",
                "resultVar": "d_ssp"
              }
            ]
          },
          {
            "id": "5e92491c-2396-4140-98e6-e4c74422784e",
            "name": "d_group",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "line_sub_ids",
                "varName": "each",
                "expression": "if(eq(upper(lookup(cat_parent_child, cat_product_u, lookup(d_prod, line_sub_ids, each))), \"CHILD\"), upper(lookup(cat_parent_code, cat_product_u, lookup(d_prod, line_sub_ids, each))), lookup(d_prod, line_sub_ids, each))",
                "resultVar": "d_group"
              }
            ]
          },
          {
            "id": "690ede2e-961b-4852-8c15-c73ebca0ed1b",
            "name": "d_cancel",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "line_sub_ids",
                "varName": "each",
                "expression": "if(gt(sum(multiply(multiply(multiply(eq(d_prod, lookup(d_group, line_sub_ids, each)), line_sale_prices), sub_recip), subtract(1, d_is_credit))), 0.005), if(lt(abs(sum(multiply(multiply(eq(d_prod, lookup(d_group, line_sub_ids, each)), line_sale_prices), sub_recip))), 0.005), 1, 0), 0)",
                "resultVar": "d_cancel"
              }
            ]
          },
          {
            "id": "f02d083a-16f3-4e0c-9fcd-91edc2156ff0",
            "name": "d_prod_recip",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "line_sub_ids",
                "varName": "each",
                "expression": "divide(1, sum(multiply(eq(d_prod, lookup(d_prod, line_sub_ids, each)), sub_recip)))",
                "resultVar": "d_prod_recip"
              }
            ]
          },
          {
            "id": "1c325200-3a4a-4877-a191-809418dc488f",
            "name": "d_basis",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(multiply(multiply(d_ssp, d_prod_recip), sub_recip), subtract(1, d_cancel)))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "fdf6636b-2147-4334-8d3e-40dd5ff8141b",
            "name": "d_money",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(multiply(line_sale_prices, sub_recip), subtract(1, d_cancel)))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "89536108-79a9-4351-abcc-235710b8255f",
            "name": "d_nc_count",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "line_sub_ids",
                "varName": "each",
                "expression": "sum(multiply(multiply(eq(d_prod, lookup(d_prod, line_sub_ids, each)), subtract(1, d_is_credit)), sub_recip))",
                "resultVar": "d_nc_count"
              }
            ]
          },
          {
            "id": "e29aa5f4-6f3c-4ae3-b926-54955f253fbf",
            "name": "d_prod_money",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "line_sub_ids",
                "varName": "each",
                "expression": "sum(multiply(multiply(eq(d_prod, lookup(d_prod, line_sub_ids, each)), line_sale_prices), sub_recip))",
                "resultVar": "d_prod_money"
              }
            ]
          },
          {
            "id": "1be07720-2096-4a9a-9edd-82ffdb612fd2",
