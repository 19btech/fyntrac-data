            "name": "dl_inv",
            "stepType": "calc",
            "source": "formula",
            "formula": "collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_INVOICE_NUMBER_CURRENT')",
            "value": "",
            "eventField": ""
          },
          {
            "id": "721c33bc-ad12-4775-9a8e-2936ae18f4c6",
            "name": "dl_nc_key",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "if(eq(lookup(line_products_u, subinstrumentid, each), \"DISCOUNT-USD\"), lookup(line_products, subinstrumentid, each), if(lt(lookup(line_sale_prices, subinstrumentid, each), 0), \"__CREDIT__\", if(eq(lookup(line_sale_prices, subinstrumentid, each), 0), if(lt(sum(multiply(eq(dl_inv, lookup(dl_inv, subinstrumentid, each)), line_sale_prices)), 0), \"__CREDIT__\", lookup(line_products, subinstrumentid, each)), lookup(line_products, subinstrumentid, each))))",
                "resultVar": "dl_nc_key"
              }
            ],
            "commentText": "product for non-credit lines, __CREDIT__ for credit lines (same credit test as line_is_credit) - used to find the original line a credit reverses"
          },
          {
            "id": "b799033e-45b2-4faa-8601-0aa741a4cc37",
            "name": "line_starts",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "if(eq(lookup(dl_nc_key, subinstrumentid, each), \"__CREDIT__\"), if(gt(sum(eq(dl_nc_key, lookup(line_products, subinstrumentid, each))), 0), if(gt(date_diff_days(lookup(line_ends_raw, dl_nc_key, lookup(line_products, subinstrumentid, each)), lookup(line_ends_raw, subinstrumentid, each)), 0), lookup(line_starts_raw, dl_nc_key, lookup(line_products, subinstrumentid, each)), lookup(line_starts_raw, subinstrumentid, each)), lookup(line_starts_raw, subinstrumentid, each)), lookup(line_starts_raw, subinstrumentid, each))",
                "resultVar": "line_starts"
              }
            ],
            "inlineComment": false,
            "commentText": "effective service start: a credit whose term ends after the original line it reverses takes the original line's dates",
            "printResult": false
          },
          {
            "id": "b18c0191-09b9-48c8-a9e6-98b0d45a842f",
            "name": "line_ends",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "if(eq(lookup(dl_nc_key, subinstrumentid, each), \"__CREDIT__\"), if(gt(sum(eq(dl_nc_key, lookup(line_products, subinstrumentid, each))), 0), if(gt(date_diff_days(lookup(line_ends_raw, dl_nc_key, lookup(line_products, subinstrumentid, each)), lookup(line_ends_raw, subinstrumentid, each)), 0), lookup(line_ends_raw, dl_nc_key, lookup(line_products, subinstrumentid, each)), lookup(line_ends_raw, subinstrumentid, each)), lookup(line_ends_raw, subinstrumentid, each)), lookup(line_ends_raw, subinstrumentid, each))",
                "resultVar": "line_ends"
              }
            ],
            "inlineComment": false,
            "commentText": "effective service end: a credit whose term ends after the original line it reverses takes the original line's end",
            "printResult": false
          },
          {
