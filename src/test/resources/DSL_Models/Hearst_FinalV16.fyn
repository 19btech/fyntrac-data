          },
          {
            "id": "5fa5c76b-c0d5-4415-952b-f72608957e46",
            "name": "boarding_month_end",
            "stepType": "calc",
            "source": "formula",
            "formula": "end_of_month(array_get(line_postings, 0, postingdate))",
            "value": "",
            "eventField": "",
            "printResult": false,
            "inlineComment": false,
            "commentText": ""
          },
          {
            "id": "88987263-e199-42d7-9532-3067daba68dd",
            "name": "line_policies",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "lookup(cat_policy, cat_product, each)",
                "resultVar": "line_policies",
                "sourceArray": "line_products",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "a47132ae-5a38-41d1-b730-dac821258636",
            "name": "line_ssp_dollar",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "lookup(cat_ssp_amount, cat_product, each)",
                "resultVar": "line_ssp_dollar",
                "sourceArray": "line_products",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "f9a69f7f-0b6f-45cd-bc9e-9c39cad629e0",
            "name": "line_ssp_amounts",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_policies, line_products, each), \"DOLLAR_AMOUNT\"), lookup(line_ssp_dollar, line_products, each), lookup(line_sale_prices, line_products, each))",
                "resultVar": "line_ssp_amounts",
                "sourceArray": "line_products",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "f1c419da-6209-49b1-8cc5-e9576755f77b",
            "name": "line_inv",
            "stepType": "calc",
            "source": "formula",
            "formula": "collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_INVOICE_NUMBER_CURRENT')",
            "value": "",
            "eventField": "",
            "collectType": "collect_by_instrument"
          },
          {
            "id": "01f01a37-4cd7-41a6-8020-2d3127fd1adc",
            "name": "line_refinv",
            "stepType": "calc",
            "source": "formula",
            "formula": "collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_REFERENCE_INVOICE_NUMBER_CURRENT')",
            "value": "",
            "eventField": "",
            "collectType": "collect_by_instrument"
          },
          {
            "id": "6f5ae4fa-e21e-4c7f-88f1-a7d0531ed50a",
            "name": "line_is_credit",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(neq(lookup(line_inv, line_sub_ids, each), lookup(line_refinv, line_sub_ids, each)), 1, 0)",
                "resultVar": "line_is_credit",
                "sourceArray": "line_sub_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "7ae0681b-42b4-41e1-ae34-11b407430b90",
            "name": "line_sale_price_nc",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "multiply(lookup(line_sale_prices, line_sub_ids, each), subtract(1, lookup(line_is_credit, line_sub_ids, each)))",
                "resultVar": "line_sale_price_nc",
                "sourceArray": "line_sub_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "55ef493c-be73-4ba1-83da-42ca72a9550f",
            "name": "line_ssp_nc",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "multiply(lookup(line_ssp_amounts, line_sub_ids, each), subtract(1, lookup(line_is_credit, line_sub_ids, each)))",
                "resultVar": "line_ssp_nc",
                "sourceArray": "line_sub_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "72acce17-da39-446b-aa3c-fffcd36a1905",
            "name": "total_sale_price",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(line_sale_price_nc)",
            "value": "",
            "eventField": "",
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "c839b1fe-5bda-4a59-a88d-873018a80002",
            "name": "total_ssp",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(line_ssp_nc)",
            "value": "",
            "eventField": "",
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "44effa04-b214-499f-92d3-5566d4139ce1",
            "name": "line_ratios",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(total_ssp, 0), 0, divide(lookup(line_ssp_amounts, line_sub_ids, each), total_ssp))",
                "resultVar": "line_ratios",
                "sourceArray": "line_sub_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "96d349f7-56bc-4d08-8502-43a90a2f685e",
            "name": "sub_recip",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "divide(1, sum(eq(line_sub_ids, each)))",
                "resultVar": "sub_recip",
                "sourceArray": "line_sub_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "7b97245e-30ea-421b-a0ec-e7834bd644bf",
            "name": "distinct_prod_count",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(sub_recip)",
            "value": "",
            "eventField": ""
          },
          {
            "id": "a6fc7a8d-1297-4c5e-af5d-b8640a6d43f3",
            "name": "line_base_alloc",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "round(multiply(lookup(line_ratios, line_sub_ids, each), total_sale_price), 4)",
                "resultVar": "line_base_alloc",
                "sourceArray": "line_sub_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "ea6e59a3-ff9f-408a-b699-4152f1b9507f",
            "name": "line_base_alloc_adj",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(gt(multiply(multiply(eq(total_ssp, 0), eq(distinct_prod_count, 1)), eq(lookup(line_ssp_amounts, line_sub_ids, each), 0)), 0), lookup(line_sale_prices, line_sub_ids, each), lookup(line_base_alloc, line_sub_ids, each))",
                "resultVar": "line_base_alloc_adj",
                "sourceArray": "line_sub_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "4b5fbd7f-033a-4250-94a6-fedf144e0194",
            "name": "noncredit_product_key",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_is_credit, line_sub_ids, each), 1), \"__CREDIT__\", lookup(line_products, line_sub_ids, each))",
                "resultVar": "noncredit_product_key",
                "sourceArray": "line_sub_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "066a26e0-4f79-4c9c-a73b-a4eaae2f187c",
            "name": "line_allocated",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_is_credit, line_sub_ids, each), 1), subtract(0, lookup(line_base_alloc_adj, noncredit_product_key, lookup(line_products, line_sub_ids, each))), lookup(line_base_alloc_adj, line_sub_ids, each))",
                "resultVar": "line_allocated",
                "sourceArray": "line_sub_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "003f3da8-e103-449e-a731-cd4dc5988784",
            "name": "allocated_for_line",
            "stepType": "calc",
            "source": "formula",
            "formula": "lookup(line_allocated, line_sub_ids, this_sub)",
            "value": "",
            "eventField": "",
            "printResult": false,
            "inlineComment": false,
            "commentText": ""
          },
          {
            "id": "a9d6f084-ada3-4e02-b08a-e2a7f1ead65b",
            "name": "delivery_amount",
            "stepType": "calc",
            "source": "formula",
            "formula": "round(multiply(units, allocated_for_line), 4)",
            "value": "",
            "eventField": "",
            "printResult": false,
            "inlineComment": false,
            "commentText": ""
          },
          {
            "id": "5b424081-d26c-4c6e-aeb9-4e5a11a4dbb0",
            "name": "delivery_ppa",
            "stepType": "calc",
            "source": "formula",
            "formula": "if(gt(date_diff_days(end_of_month(delivery_effdate), end_of_month(postingdate)), 0), delivery_amount, 0)",
            "value": "",
            "eventField": ""
          },
          {
            "id": "fcbb558e-dcae-410b-bb3d-8c9f221731be",
            "name": "delivery_revenue",
            "stepType": "calc",
            "source": "formula",
            "formula": "if(lte(date_diff_days(end_of_month(delivery_effdate), end_of_month(postingdate)), 0), delivery_amount, 0)",
            "value": "",
            "eventField": ""
          },
          {
            "id": "eeaf0843-ecb6-48e9-be2e-5512460abb7d",
            "name": "pdel_days",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "date_diff_days(lookup(pdel_postings, pdel_ids, each), postingdate)",
                "resultVar": "pdel_days",
                "sourceArray": "pdel_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "98257987-e291-49c8-9b36-3b00ef69790e",
            "name": "pdel_term_days",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "date_diff_days(lookup(pdel_postings, pdel_ids, each), lookup(line_ends, line_sub_ids, lookup(pdel_subids, pdel_ids, each)))",
                "resultVar": "pdel_term_days",
                "sourceArray": "pdel_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "e6fd7d3a-ef9c-437b-9bf5-91e9f73cc0ad",
            "name": "del_cum_incl",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "sum(multiply(multiply(multiply(eq(pdel_subids, lookup(pdel_subids, pdel_ids, each)), gte(pdel_term_days, 0)), gte(pdel_days, 0)), pdel_units))",
                "resultVar": "del_cum_incl",
                "sourceArray": "pdel_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "a2a80ea9-e7b8-42aa-ae70-7a4b14ebcf5c",
            "name": "del_cum_prior",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "sum(multiply(multiply(multiply(eq(pdel_subids, lookup(pdel_subids, pdel_ids, each)), gte(pdel_term_days, 0)), gt(pdel_days, 0)), pdel_units))",
                "resultVar": "del_cum_prior",
                "sourceArray": "pdel_ids",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "c583622b-56dc-4ae4-9eb5-d4306aca62f3",
            "name": "del_n_logs",
            "stepType": "iteration",
            "iterations": [
              {
