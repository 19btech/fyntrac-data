          },
          {
            "id": "a20cb008-12aa-4a4a-879d-dc689d86bda9",
            "name": "pdel_units",
            "stepType": "calc",
            "source": "formula",
            "formula": "collect_by_instrument('PROF_SERVICE_DELIVERY_units_delivered')",
            "value": "",
            "eventField": "",
            "collectType": "collect_by_instrument"
          },
          {
            "id": "a1c01ea6-98e3-44e4-b4a4-f0ea84c5e525",
            "name": "pdel_postings",
            "stepType": "calc",
            "source": "formula",
            "formula": "collect_by_instrument('PROF_SERVICE_DELIVERY_postingdate')",
            "value": "",
            "eventField": "",
            "collectType": "collect_by_instrument"
          },
          {
            "id": "e0637bdf-357f-405d-a733-6dce52aa54d5",
            "name": "cur_delivery_units",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "sum(multiply(multiply(eq(pdel_subids, each), eq(pdel_postings, postingdate)), pdel_units))",
                "resultVar": "cur_delivery_units",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "d6c9c281-c2fb-46cb-987d-28d3ea73d048",
            "name": "line_policies",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "lookup(cat_policy, cat_product, lookup(line_products, subinstrumentid, each))",
                "resultVar": "line_policies",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "4ba23289-e1d2-4fe4-ada0-94f4c2beee17",
            "name": "line_ssp_dollar",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "lookup(cat_ssp_amount, cat_product, lookup(line_products, subinstrumentid, each))",
                "resultVar": "line_ssp_dollar",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "77879831-24e6-4ef8-86a6-bcbf3b04b5de",
            "name": "line_methods",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "lookup(cat_method, cat_product, lookup(line_products, subinstrumentid, each))",
                "resultVar": "line_methods",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "bd5df36a-c6fe-40bf-895c-b6542fe33fe0",
            "name": "line_ssp_raw",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_policies, subinstrumentid, each), \"DOLLAR_AMOUNT\"), lookup(line_ssp_dollar, subinstrumentid, each), lookup(line_sale_prices, subinstrumentid, each))",
                "resultVar": "line_ssp_raw",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "213fea18-3898-435b-b1e3-cdd33332f00b",
            "name": "total_ssp_raw",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(line_ssp_raw)",
            "value": "",
            "eventField": ""
          },
          {
            "id": "360160dd-0b84-4d25-880f-33cb509b4ea9",
            "name": "line_ssp_amounts",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(total_ssp_raw, 0), abs(lookup(line_sale_prices, subinstrumentid, each)), lookup(line_ssp_raw, subinstrumentid, each))",
                "resultVar": "line_ssp_amounts",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "ef0ebaa9-96fa-40e9-9426-bcc2f2976c2d",
            "name": "line_inv",
            "stepType": "calc",
            "source": "formula",
            "formula": "collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_INVOICE_NUMBER_CURRENT')",
            "value": "",
            "eventField": "",
            "collectType": "collect_by_instrument"
          },
          {
            "id": "d2c5f6ba-3ea5-46ee-96af-3b048c70514c",
            "name": "line_refinv",
            "stepType": "calc",
            "source": "formula",
            "formula": "collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_REFERENCE_INVOICE_NUMBER_CURRENT')",
            "value": "",
            "eventField": "",
            "collectType": "collect_by_instrument"
          },
          {
            "id": "9020c47c-58ce-4dad-9990-bc3150e01f10",
            "name": "line_is_credit",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(neq(lookup(line_inv, subinstrumentid, each), lookup(line_refinv, subinstrumentid, each)), 1, if(lt(lookup(line_sale_prices, subinstrumentid, each), 0), 1, 0))",
                "resultVar": "line_is_credit",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "3d17b2b1-e081-4efb-b71f-a062585447c6",
            "name": "line_sale_price_nc",
            "stepType": "iteration",
            "iterations": [
              {
                "type": "apply_each",
                "sourceArray": "subinstrumentid",
                "varName": "each",
                "expression": "multiply(lookup(line_sale_prices, subinstrumentid, each), subtract(1, lookup(line_is_credit, subinstrumentid, each)))",
                "resultVar": "line_sale_price_nc"
              }
            ]
          },
          {
            "id": "00fe95c7-cf48-4395-8dfe-4a9c2e4a728c",
            "name": "line_ssp_nc",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "multiply(lookup(line_ssp_amounts, subinstrumentid, each), subtract(1, lookup(line_is_credit, subinstrumentid, each)))",
                "resultVar": "line_ssp_nc",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "d7942949-d8c4-4e68-94eb-f1c4ab39bed5",
            "name": "total_sale_price",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(line_sale_price_nc)",
            "value": "",
            "eventField": "",
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "86537acc-7af5-4988-9eed-6a99a1a94282",
            "name": "total_ssp",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(line_ssp_nc)",
            "value": "",
            "eventField": "",
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "7e016611-44a6-433e-aa39-350f21b3f97a",
            "name": "line_ratios",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(total_ssp, 0), 0, divide(lookup(line_ssp_amounts, subinstrumentid, each), total_ssp))",
                "resultVar": "line_ratios",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "ebc16e24-62f7-425f-a6fb-9aa491085876",
            "name": "sub_recip",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "divide(1, sum(eq(subinstrumentid, each)))",
                "resultVar": "sub_recip",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "c5eff108-08b3-4391-ad79-e2c810765efb",
            "name": "distinct_prod_count",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(sub_recip)",
            "value": "",
            "eventField": ""
          },
          {
            "id": "abdce62a-9a5f-4494-9fed-2918adf24caa",
            "name": "total_ssp_d",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(line_ssp_nc, sub_recip))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "709c7b0b-aaf9-4a37-888d-7a6954738da0",
            "name": "credit_pool_d",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(multiply(line_sale_prices, line_is_credit), sub_recip))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "7b3cb1bb-c0d8-42bf-ad77-c5ca4f591cdc",
            "name": "line_base_alloc",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "multiply(lookup(line_ratios, subinstrumentid, each), total_sale_price)",
                "resultVar": "line_base_alloc",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": true
          },
          {
            "id": "1dc38225-73b3-44fe-83d1-a97f8d30e233",
            "name": "line_base_alloc_adj",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "lookup(line_base_alloc, subinstrumentid, each)",
                "resultVar": "line_base_alloc_adj",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "d46de78b-ed67-4823-835a-2616fd3e80b8",
            "name": "noncredit_product_key",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_is_credit, subinstrumentid, each), 1), \"__CREDIT__\", lookup(line_products, subinstrumentid, each))",
                "resultVar": "noncredit_product_key",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "4d6a78f9-059b-4bdc-aca2-a35e6f9a029a",
            "name": "credit_pool_line",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "sum(multiply(multiply(multiply(eq(line_inv, lookup(line_inv, subinstrumentid, each)), line_is_credit), line_sale_prices), sub_recip))",
                "resultVar": "credit_pool_line",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "2dee95b6-8864-4203-9d30-0820ee362b83",
            "name": "line_alloc_raw",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_is_credit, subinstrumentid, each), 1), if(eq(total_ssp_d, 0), lookup(line_sale_prices, subinstrumentid, each), multiply(divide(lookup(line_ssp_amounts, subinstrumentid, each), total_ssp_d), lookup(credit_pool_line, subinstrumentid, each))), lookup(line_base_alloc_adj, subinstrumentid, each))",
                "resultVar": "line_alloc_raw",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "0ea3ec58-7d19-4a99-93c1-1863406e0249",
            "name": "line_alloc_r",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "round(lookup(line_alloc_raw, subinstrumentid, each), 4)",
                "resultVar": "line_alloc_r",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "a7672602-768b-48cd-811d-dc109ffcb567",
            "name": "total_sale_price_d",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(line_sale_price_nc, sub_recip))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "566dc1d6-23cd-46d2-a7e6-7453acbdf0bc",
            "name": "alloc_sum_r",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(line_alloc_r, sub_recip))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "3ef62fc9-6be4-43d9-8a56-eb33d2e99bbd",
            "name": "alloc_residual",
            "stepType": "calc",
            "source": "formula",
            "formula": "subtract(add(total_sale_price_d, credit_pool_d), alloc_sum_r)",
            "value": "",
            "eventField": ""
          },
          {
            "id": "c6185285-2408-493a-9e92-733f3cb2432f",
            "name": "alloc_max",
            "stepType": "calc",
            "source": "formula",
            "formula": "array_get(line_alloc_r, 0, 0)",
            "value": "",
            "eventField": ""
          },
          {
            "id": "c3b6e985-e8ea-4af0-909f-1f7e0c50477a",
            "name": "alloc_tied",
            "stepType": "calc",
            "source": "formula",
            "formula": "sum(multiply(eq(line_alloc_r, alloc_max), sub_recip))",
            "value": "",
            "eventField": ""
          },
          {
            "id": "3c03b2da-59a0-44e9-8ae6-576f6c826b03",
            "name": "line_allocated",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "add(lookup(line_alloc_r, subinstrumentid, each), if(eq(alloc_tied, 0), 0, if(gte(abs(alloc_residual), 0.005), 0, if(eq(lookup(line_alloc_r, subinstrumentid, each), alloc_max), divide(alloc_residual, alloc_tied), 0))))",
                "resultVar": "line_allocated",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "b0a7cb5f-4d66-42db-8645-8d19fb047844",
            "name": "line_balance",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "sum(multiply(eq(bal_subids, each), bal_amounts))",
                "resultVar": "line_balance",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "keyed by sub-id, not positional; yields 0 when a line has no balance row yet",
            "printResult": false
          },
          {
            "id": "4fcd460a-7b2c-4204-802a-9ca799e61d36",
            "name": "bal_postings",
            "stepType": "calc",
            "source": "formula",
            "formula": "collect_by_instrument('REVENUE_BALANCE_postingdate')",
            "value": "",
            "eventField": "",
            "commentText": "posting date carried on this instrument's balance rows"
          },
          {
            "id": "e22ce518-75d4-4fae-b7c3-6cce32e50cfe",
            "name": "stale_balance_error",
            "stepType": "calc",
            "source": "formula",
            "formula": "if(eq(array_length(bal_postings), 0), 0, if(eq(date_diff_days(array_get(bal_postings, 0, postingdate), postingdate), 0), 0, 1))",
            "value": "",
            "eventField": "",
            "commentText": "CONTROL - 1 when a balance row exists but is not for this posting period, i.e. the prior period's balance was never written. Must be 0.",
            "printResult": true
          },
          {
            "id": "46d7d512-f479-4066-a938-259d43979b95",
            "name": "balance_row_count",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "sum(eq(bal_subids, each))",
                "resultVar": "balance_row_count",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "commentText": "count of balance rows matching each order line - must be 1 (or 0 before the first balance is written). 2+ means duplicates are double-counting the balance.",
            "printResult": false
          },
          {
            "id": "5a545be1-de2e-46c6-8535-77be71e0b12b",
            "name": "balance_alignment_error",
            "stepType": "calc",
            "source": "formula",
            "formula": "if(gt(sum(balance_row_count), array_length(bal_subids)), 1, 0)",
            "value": "",
            "eventField": "",
            "commentText": "CONTROL - 1 when any order line has more than one balance row, i.e. the balance feed has duplicates. Must be 0.",
            "printResult": true
          },
          {
            "id": "ea4c35ef-947a-49d0-8fab-771ddd867d07",
            "name": "cur_delivery_amount",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "multiply(lookup(cur_delivery_units, subinstrumentid, each), lookup(line_allocated, subinstrumentid, each))",
                "resultVar": "cur_delivery_amount",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ]
          },
          {
            "id": "e82eab77-0f2b-497d-8294-043a14f04892",
            "name": "line_remaining",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_methods, subinstrumentid, each), \"PROPORTIONAL_PERFORMANCE\"), subtract(add(lookup(line_allocated, subinstrumentid, each), lookup(line_balance, subinstrumentid, each)), lookup(cur_delivery_amount, subinstrumentid, each)), if(gte(lookup(line_allocated, subinstrumentid, each), 0), max(subtract(lookup(line_allocated, subinstrumentid, each), lookup(line_balance, subinstrumentid, each)), 0), min(subtract(lookup(line_allocated, subinstrumentid, each), lookup(line_balance, subinstrumentid, each)), 0)))",
                "resultVar": "line_remaining",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "printResult": true
          },
          {
            "id": "71480db9-b4e6-48a9-826a-3e7192d807bb",
            "name": "line_po_days",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "add(date_diff_days(lookup(line_starts, subinstrumentid, each), lookup(line_ends, subinstrumentid, each)), 1)",
                "resultVar": "line_po_days",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "f7589e97-e90a-4855-8a8e-8bc131125046",
            "name": "line_per_day",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_po_days, subinstrumentid, each), 0), 0, divide(lookup(line_allocated, subinstrumentid, each), lookup(line_po_days, subinstrumentid, each)))",
                "resultVar": "line_per_day",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
            "commentText": "",
            "printResult": false
          },
          {
            "id": "3463fe38-553c-492b-a0ab-d8933dfc70e7",
            "name": "line_is_ratable",
            "stepType": "iteration",
            "iterations": [
              {
                "expression": "if(eq(lookup(line_methods, subinstrumentid, each), \"RATABLE\"), 1, 0)",
                "resultVar": "line_is_ratable",
                "sourceArray": "subinstrumentid",
                "type": "apply_each",
                "varName": "each"
              }
            ],
            "inlineComment": false,
