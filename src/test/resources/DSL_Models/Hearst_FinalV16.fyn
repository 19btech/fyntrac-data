            "formula": "round(if(gt(multiply(units, allocated_for_line), if(lt(add(allocated_for_line, sum(multiply(eq(bal_subids, this_sub), bal_amounts))), 0), 0, add(allocated_for_line, sum(multiply(eq(bal_subids, this_sub), bal_amounts))))), if(lt(add(allocated_for_line, sum(multiply(eq(bal_subids, this_sub), bal_amounts))), 0), 0, add(allocated_for_line, sum(multiply(eq(bal_subids, this_sub), bal_amounts)))), multiply(units, allocated_for_line)), 4)",
