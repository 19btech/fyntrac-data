        "generatedCode": "## ═══════════════════════════════════════════════════════════════\n## REVREC_BILLING\n## ═══════════════════════════════════════════════════════════════\n\n## Steps\npostingdate = BILLING_SCHEDULE.postingdate\neffectivedate = BILLING_SCHEDULE.effectivedate\nsubinstrumentid = collect_by_instrument(BILLING_SCHEDULE.subinstrumentid)\nbilling_amount = collect_by_instrument('BILLING_SCHEDULE_billing_amount')\n\n## Create Transactions\ncreateTransaction(postingdate, effectivedate, \"NEW_BILLING\", billing_amount, subinstrumentid)",
