    "schedules": [],
    "combinedCode": "## ═══════════════════════════════════════════════════════════════\n## REVREC_REVENUE_RECOGNITION\n## ═══════════════════════════════════════════════════════════════\n\n## Steps\npostingdate = SALE_ORDER_DETAILS.postingdate\neffectivedate = SALE_ORDER_DETAILS.postingdate\nsubinstrumentid = collect_by_instrument(SALE_ORDER_DETAILS.subinstrumentid)\nregister_ssp = collect_all(SSP_RULE.ssp_amount)\nregister_balance = collect_by_instrument(REVENUE_BALANCE.BALANCES_ENDINGBALANCE_TOTAL_REVENUE)\ncat_product = collect_all('SSP_RULE_product_code')\ncat_policy = collect_all('SSP_RULE_standalone_price_policy')\ncat_ssp_amount = collect_all('SSP_RULE_ssp_amount')\ncat_method = collect_all('SSP_RULE_recognition_method')\nline_products = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_PRODUCT_ID_CURRENT')\nline_sale_prices = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_SALE_PRICE_CURRENT')\nline_starts = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_SERVICE_START_DATE_CURRENT')\nline_ends = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_SERVICE_END_DATE_CURRENT')\nmissing_order_terms = if(eq(array_length(subinstrumentid), 0), 1, 0)\nline_postings = collect_by_instrument('SALE_ORDER_DETAILS_postingdate')\nbal_subids = collect_by_instrument('REVENUE_BALANCE_subinstrumentid')\nbal_amounts = collect_by_instrument('REVENUE_BALANCE_BALANCES_ENDINGBALANCE_TOTAL_REVENUE')\nboarding_month_end = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_TRANSACTIONDATE_CURRENT')\nregister_delivery = collect_by_instrument(PROF_SERVICE_DELIVERY.units_delivered)\npdel_subids = collect_by_instrument('PROF_SERVICE_DELIVERY_subinstrumentid')\npdel_units = collect_by_instrument('PROF_SERVICE_DELIVERY_units_delivered')\npdel_postings = collect_by_instrument('PROF_SERVICE_DELIVERY_postingdate')\n## Iteration\ncur_delivery_units = apply_each(subinstrumentid, \"sum(multiply(multiply(eq(pdel_subids, each), eq(pdel_postings, postingdate)), pdel_units))\", {\"postingdate\": postingdate, \"subinstrumentid\": subinstrumentid, \"pdel_subids\": pdel_subids, \"pdel_units\": pdel_units, \"pdel_postings\": pdel_postings})\n\n## Iteration\nline_policies = apply_each(subinstrumentid, \"lookup(cat_policy, cat_product, lookup(line_products, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"cat_product\": cat_product, \"cat_policy\": cat_policy, \"line_products\": line_products})\n\n## Iteration\nline_ssp_dollar = apply_each(subinstrumentid, \"lookup(cat_ssp_amount, cat_product, lookup(line_products, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"cat_product\": cat_product, \"cat_ssp_amount\": cat_ssp_amount, \"line_products\": line_products})\n\n## Iteration\nline_methods = apply_each(subinstrumentid, \"lookup(cat_method, cat_product, lookup(line_products, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"cat_product\": cat_product, \"cat_method\": cat_method, \"line_products\": line_products})\n\n## Iteration\nline_ssp_raw = apply_each(subinstrumentid, \"if(eq(lookup(line_policies, subinstrumentid, each), \\\"DOLLAR_AMOUNT\\\"), lookup(line_ssp_dollar, subinstrumentid, each), lookup(line_sale_prices, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"line_sale_prices\": line_sale_prices, \"line_policies\": line_policies, \"line_ssp_dollar\": line_ssp_dollar})\n\ntotal_ssp_raw = sum(line_ssp_raw)\n## Iteration\nline_ssp_amounts = apply_each(subinstrumentid, \"if(eq(total_ssp_raw, 0), abs(lookup(line_sale_prices, subinstrumentid, each)), lookup(line_ssp_raw, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"line_sale_prices\": line_sale_prices, \"line_ssp_raw\": line_ssp_raw, \"total_ssp_raw\": total_ssp_raw})\n\nline_inv = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_INVOICE_NUMBER_CURRENT')\nline_refinv = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_REFERENCE_INVOICE_NUMBER_CURRENT')\n## Iteration\nline_is_credit = apply_each(subinstrumentid, \"if(neq(lookup(line_inv, subinstrumentid, each), lookup(line_refinv, subinstrumentid, each)), 1, if(lt(lookup(line_sale_prices, subinstrumentid, each), 0), 1, 0))\", {\"subinstrumentid\": subinstrumentid, \"line_sale_prices\": line_sale_prices, \"line_inv\": line_inv, \"line_refinv\": line_refinv})\n\n## Iteration\nline_sale_price_nc = apply_each(subinstrumentid, \"multiply(lookup(line_sale_prices, subinstrumentid, each), subtract(1, lookup(line_is_credit, subinstrumentid, each)))\", {\"subinstrumentid\": subinstrumentid, \"line_sale_prices\": line_sale_prices, \"line_is_credit\": line_is_credit})\n\n## Iteration\nline_ssp_nc = apply_each(subinstrumentid, \"multiply(lookup(line_ssp_amounts, subinstrumentid, each), subtract(1, lookup(line_is_credit, subinstrumentid, each)))\", {\"subinstrumentid\": subinstrumentid, \"line_ssp_amounts\": line_ssp_amounts, \"line_is_credit\": line_is_credit})\n\ntotal_sale_price = sum(line_sale_price_nc)\ntotal_ssp = sum(line_ssp_nc)\n## Iteration\nline_ratios = apply_each(subinstrumentid, \"if(eq(total_ssp, 0), 0, divide(lookup(line_ssp_amounts, subinstrumentid, each), total_ssp))\", {\"subinstrumentid\": subinstrumentid, \"line_ssp_amounts\": line_ssp_amounts, \"total_ssp\": total_ssp})\n\n## Iteration\nsub_recip = apply_each(subinstrumentid, \"divide(1, sum(eq(subinstrumentid, each)))\", {\"subinstrumentid\": subinstrumentid})\n\ndistinct_prod_count = sum(sub_recip)\ntotal_ssp_d = sum(multiply(line_ssp_nc, sub_recip))\ncredit_pool_d = sum(multiply(multiply(line_sale_prices, line_is_credit), sub_recip))\n## Iteration\nline_base_alloc = apply_each(subinstrumentid, \"multiply(lookup(line_ratios, subinstrumentid, each), total_sale_price)\", {\"subinstrumentid\": subinstrumentid, \"total_sale_price\": total_sale_price, \"line_ratios\": line_ratios})\n\n## Iteration\nline_base_alloc_adj = apply_each(subinstrumentid, \"lookup(line_base_alloc, subinstrumentid, each)\", {\"subinstrumentid\": subinstrumentid, \"line_base_alloc\": line_base_alloc})\n\n## Iteration\nnoncredit_product_key = apply_each(subinstrumentid, \"if(eq(lookup(line_is_credit, subinstrumentid, each), 1), \\\"__CREDIT__\\\", lookup(line_products, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"line_products\": line_products, \"line_is_credit\": line_is_credit})\n\n## Iteration\ncredit_pool_line = apply_each(subinstrumentid, \"sum(multiply(multiply(multiply(eq(line_inv, lookup(line_inv, subinstrumentid, each)), line_is_credit), line_sale_prices), sub_recip))\", {\"subinstrumentid\": subinstrumentid, \"line_sale_prices\": line_sale_prices, \"line_inv\": line_inv, \"line_is_credit\": line_is_credit, \"sub_recip\": sub_recip})\n\n## Iteration\nline_alloc_raw = apply_each(subinstrumentid, \"if(eq(lookup(line_is_credit, subinstrumentid, each), 1), if(eq(total_ssp_d, 0), lookup(line_sale_prices, subinstrumentid, each), multiply(divide(lookup(line_ssp_amounts, subinstrumentid, each), total_ssp_d), lookup(credit_pool_line, subinstrumentid, each))), lookup(line_base_alloc_adj, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"line_sale_prices\": line_sale_prices, \"line_ssp_amounts\": line_ssp_amounts, \"line_is_credit\": line_is_credit, \"total_ssp_d\": total_ssp_d, \"line_base_alloc_adj\": line_base_alloc_adj, \"credit_pool_line\": credit_pool_line})\n\n## Iteration\nline_alloc_r = apply_each(subinstrumentid, \"round(lookup(line_alloc_raw, subinstrumentid, each), 4)\", {\"subinstrumentid\": subinstrumentid, \"line_alloc_raw\": line_alloc_raw})\n\ntotal_sale_price_d = sum(multiply(line_sale_price_nc, sub_recip))\nalloc_sum_r = sum(multiply(line_alloc_r, sub_recip))\nalloc_residual = subtract(add(total_sale_price_d, credit_pool_d), alloc_sum_r)\nalloc_max = array_get(line_alloc_r, 0, 0)\nalloc_tied = sum(multiply(eq(line_alloc_r, alloc_max), sub_recip))\n## Iteration\nline_allocated = apply_each(subinstrumentid, \"add(lookup(line_alloc_r, subinstrumentid, each), if(eq(alloc_tied, 0), 0, if(gte(abs(alloc_residual), 0.005), 0, if(eq(lookup(line_alloc_r, subinstrumentid, each), alloc_max), divide(alloc_residual, alloc_tied), 0))))\", {\"subinstrumentid\": subinstrumentid, \"line_alloc_r\": line_alloc_r, \"alloc_residual\": alloc_residual, \"alloc_max\": alloc_max, \"alloc_tied\": alloc_tied})\n\n## Iteration\nline_balance = apply_each(subinstrumentid, \"sum(multiply(eq(bal_subids, each), bal_amounts))\", {\"subinstrumentid\": subinstrumentid, \"bal_subids\": bal_subids, \"bal_amounts\": bal_amounts})\n\nbal_postings = collect_by_instrument('REVENUE_BALANCE_postingdate')\nstale_balance_error = if(eq(array_length(bal_postings), 0), 0, if(eq(date_diff_days(array_get(bal_postings, 0, postingdate), postingdate), 0), 0, 1))\n## Iteration\nbalance_row_count = apply_each(subinstrumentid, \"sum(eq(bal_subids, each))\", {\"subinstrumentid\": subinstrumentid, \"bal_subids\": bal_subids})\n\nbalance_alignment_error = if(gt(sum(balance_row_count), array_length(bal_subids)), 1, 0)\n## Iteration\ncur_delivery_amount = apply_each(subinstrumentid, \"multiply(lookup(cur_delivery_units, subinstrumentid, each), lookup(line_allocated, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"cur_delivery_units\": cur_delivery_units, \"line_allocated\": line_allocated})\n\n## Iteration\nline_remaining = apply_each(subinstrumentid, \"if(eq(lookup(line_methods, subinstrumentid, each), \\\"PROPORTIONAL_PERFORMANCE\\\"), subtract(add(lookup(line_allocated, subinstrumentid, each), lookup(line_balance, subinstrumentid, each)), lookup(cur_delivery_amount, subinstrumentid, each)), if(gte(lookup(line_allocated, subinstrumentid, each), 0), max(subtract(lookup(line_allocated, subinstrumentid, each), lookup(line_balance, subinstrumentid, each)), 0), min(subtract(lookup(line_allocated, subinstrumentid, each), lookup(line_balance, subinstrumentid, each)), 0)))\", {\"subinstrumentid\": subinstrumentid, \"line_methods\": line_methods, \"line_allocated\": line_allocated, \"line_balance\": line_balance, \"cur_delivery_amount\": cur_delivery_amount})\n\n## Iteration\nline_po_days = apply_each(subinstrumentid, \"add(date_diff_days(lookup(line_starts, subinstrumentid, each), lookup(line_ends, subinstrumentid, each)), 1)\", {\"subinstrumentid\": subinstrumentid, \"line_starts\": line_starts, \"line_ends\": line_ends})\n\n## Iteration\nline_per_day = apply_each(subinstrumentid, \"if(eq(lookup(line_po_days, subinstrumentid, each), 0), 0, divide(lookup(line_allocated, subinstrumentid, each), lookup(line_po_days, subinstrumentid, each)))\", {\"subinstrumentid\": subinstrumentid, \"line_allocated\": line_allocated, \"line_po_days\": line_po_days})\n\n## Iteration\nline_is_ratable = apply_each(subinstrumentid, \"if(eq(lookup(line_methods, subinstrumentid, each), \\\"RATABLE\\\"), 1, 0)\", {\"subinstrumentid\": subinstrumentid, \"line_methods\": line_methods})\n\n## Iteration\nline_is_pit = apply_each(subinstrumentid, \"if(eq(lookup(line_methods, subinstrumentid, each), \\\"POINT_IN_TIME\\\"), 1, 0)\", {\"subinstrumentid\": subinstrumentid, \"line_methods\": line_methods})\n\n## Iteration\nline_is_prop = apply_each(subinstrumentid, \"if(eq(lookup(line_methods, subinstrumentid, each), \\\"PROPORTIONAL_PERFORMANCE\\\"), 1, 0)\", {\"subinstrumentid\": subinstrumentid, \"line_methods\": line_methods})\n\n## Iteration\nline_ends_eom = apply_each(subinstrumentid, \"end_of_month(lookup(line_ends, subinstrumentid, each))\", {\"subinstrumentid\": subinstrumentid, \"line_ends\": line_ends})\n\n## Schedule\np = period(line_starts, line_ends_eom, \"M\")\nrev_schedule = schedule(p, {\n    \"period_date\": \"period_date\",\n    \"month_end\": \"end_of_month(period_date)\",\n    \"days_in_month\": \"add(date_diff_days(if(gt(date_diff_days(start_of_month(month_end), line_starts), 0), line_starts, start_of_month(month_end)), if(gt(date_diff_days(line_ends, month_end), 0), line_ends, month_end)), 1)\",\n    \"period_no\": \"add(period_index, 1)\",\n    \"prior_ltd_days\": \"date_diff_days(line_starts, start_of_month(month_end))\",\n    \"is_last\": \"if(eq(date_diff_days(month_end, end_of_month(line_ends)), 0), 1, 0)\",\n    \"gross_calc\": \"if(eq(line_is_ratable, 1), multiply(line_per_day, days_in_month), if(eq(line_is_pit, 1), if(eq(date_diff_days(month_end, end_of_month(line_starts)), 0), line_allocated, 0), if(eq(line_is_prop, 1), if(eq(is_last, 1), line_remaining, 0), if(eq(is_last, 1), line_allocated, 0))))\",\n    \"cum_prior\": \"lag('ltd_gross', 1, 0)\",\n    \"gross_revenue\": \"if(eq(multiply(is_last, line_is_ratable), 1), subtract(line_allocated, cum_prior), gross_calc)\",\n    \"boarding_me\": \"end_of_month(boarding_month_end)\",\n    \"pre_gross\": \"if(gt(date_diff_days(month_end, boarding_me), 0), gross_revenue, 0)\",\n    \"cum_pre\": \"add(lag('cum_pre', 1, 0), pre_gross)\",\n    \"revenue_ppa\": \"round(if(eq(date_diff_days(month_end, boarding_me), 0), lag('cum_pre', 1, 0), 0), 4)\",\n    \"revenue\": \"if(lte(date_diff_days(month_end, boarding_me), 0), gross_revenue, 0)\",\n    \"ltd_gross\": \"add(lag('ltd_gross', 1, 0), gross_revenue)\"\n}, {\"boarding_month_end\": boarding_month_end, \"line_allocated\": line_allocated, \"line_ends\": line_ends, \"line_is_pit\": line_is_pit, \"line_is_prop\": line_is_prop, \"line_is_ratable\": line_is_ratable, \"line_per_day\": line_per_day, \"line_remaining\": line_remaining, \"line_starts\": line_starts, \"item_names\": line_products})\nrev_now = schedule_filter(rev_schedule, \"month_end\", postingdate, \"revenue\")\nppa_now = schedule_filter(rev_schedule, \"month_end\", postingdate, \"revenue_ppa\")\nposted_rev_total = schedule_sum(rev_schedule, \"revenue\")\nltd_close = schedule_last(rev_schedule, \"ltd_gross\")\n\n## Iteration\nppa_amount = apply_each(subinstrumentid, \"round(lookup(ppa_now, subinstrumentid, each), 4)\", {\"subinstrumentid\": subinstrumentid, \"ppa_now\": ppa_now})\n\n## Iteration\nlate_credit_ppa = apply_each(subinstrumentid, \"if(gt(multiply(gt(date_diff_days(end_of_month(lookup(line_ends, subinstrumentid, each)), end_of_month(lookup(boarding_month_end, subinstrumentid, each))), 0), eq(date_diff_days(end_of_month(postingdate), end_of_month(lookup(boarding_month_end, subinstrumentid, each))), 0)), 0), lookup(line_allocated, subinstrumentid, each), 0)\", {\"postingdate\": postingdate, \"subinstrumentid\": subinstrumentid, \"line_ends\": line_ends, \"boarding_month_end\": boarding_month_end, \"line_allocated\": line_allocated})\n\n## Iteration\nrev_amount = apply_each(subinstrumentid, \"if(gt(multiply(multiply(eq(lookup(line_is_ratable, subinstrumentid, each), 1), eq(date_diff_days(end_of_month(postingdate), end_of_month(lookup(line_ends, subinstrumentid, each))), 0)), gt(array_length(bal_subids), 0)), 0), subtract(add(lookup(line_allocated, subinstrumentid, each), lookup(line_balance, subinstrumentid, each)), lookup(ppa_amount, subinstrumentid, each)), lookup(rev_now, subinstrumentid, each))\", {\"postingdate\": postingdate, \"subinstrumentid\": subinstrumentid, \"line_ends\": line_ends, \"bal_subids\": bal_subids, \"line_allocated\": line_allocated, \"line_balance\": line_balance, \"line_is_ratable\": line_is_ratable, \"rev_now\": rev_now, \"ppa_amount\": ppa_amount})\n\nrecon_difference = subtract(posted_rev_total, line_allocated)\n## Iteration\nper_line_credit_err = apply_each(subinstrumentid, \"if(eq(lookup(line_is_credit, subinstrumentid, each), 1), if(gt(abs(add(lookup(line_sale_prices, subinstrumentid, each), lookup(line_sale_prices, noncredit_product_key, lookup(line_products, subinstrumentid, each)))), 0.005), 1, 0), 0)\", {\"subinstrumentid\": subinstrumentid, \"line_products\": line_products, \"line_sale_prices\": line_sale_prices, \"line_is_credit\": line_is_credit, \"noncredit_product_key\": noncredit_product_key})\n\ncredit_amount_error = if(gt(sum(per_line_credit_err), 0), 1, 0)\n## Iteration\nratable_adj_ppa = apply_each(subinstrumentid, \"if(gt(multiply(multiply(multiply(eq(lookup(line_is_ratable, subinstrumentid, each), 1), eq(date_diff_days(end_of_month(postingdate), end_of_month(lookup(line_ends, subinstrumentid, each))), 0)), gt(array_length(bal_subids), 0)), gt(abs(subtract(subtract(add(lookup(line_allocated, subinstrumentid, each), lookup(line_balance, subinstrumentid, each)), lookup(rev_amount, subinstrumentid, each)), lookup(ppa_amount, subinstrumentid, each))), 0.005)), 0), subtract(subtract(add(lookup(line_allocated, subinstrumentid, each), lookup(line_balance, subinstrumentid, each)), lookup(rev_amount, subinstrumentid, each)), lookup(ppa_amount, subinstrumentid, each)), 0)\", {\"postingdate\": postingdate, \"subinstrumentid\": subinstrumentid, \"line_ends\": line_ends, \"bal_subids\": bal_subids, \"line_allocated\": line_allocated, \"line_balance\": line_balance, \"line_is_ratable\": line_is_ratable, \"ppa_amount\": ppa_amount, \"rev_amount\": rev_amount})\n\n## Iteration\nppa_amount_neg = apply_each(subinstrumentid, \"round(multiply(add(add(lookup(ppa_amount, subinstrumentid, each), lookup(late_credit_ppa, subinstrumentid, each)), lookup(ratable_adj_ppa, subinstrumentid, each)), -1), 4)\", {\"subinstrumentid\": subinstrumentid, \"ppa_amount\": ppa_amount, \"late_credit_ppa\": late_credit_ppa, \"ratable_adj_ppa\": ratable_adj_ppa})\n\n## Iteration\nrev_amount_neg = apply_each(subinstrumentid, \"round(multiply(lookup(rev_amount, subinstrumentid, each), -1), 4)\", {\"subinstrumentid\": subinstrumentid, \"rev_amount\": rev_amount})\n\n## Iteration\nalloc_booked = apply_each(subinstrumentid, \"if(eq(date_diff_days(end_of_month(postingdate), end_of_month(lookup(boarding_month_end, subinstrumentid, each))), 0), lookup(line_allocated, subinstrumentid, each), 0)\", {\"postingdate\": postingdate, \"subinstrumentid\": subinstrumentid, \"boarding_month_end\": boarding_month_end, \"line_allocated\": line_allocated})\n\nalloc_residual_error = if(gt(abs(alloc_residual), 0.005), 1, 0)\n\n## Create Transactions\ncreateTransaction(postingdate, effectivedate, \"Revenue\", rev_amount_neg, subinstrumentid)\ncreateTransaction(postingdate, effectivedate, \"Revenue_PPA\", ppa_amount_neg, subinstrumentid)\ncreateTransaction(postingdate, effectivedate, \"ALLOCATED_REVENUE\", alloc_booked, subinstrumentid)\n\n## ═══════════════════════════════════════════════════════════════\n## REVREC_PROPORTIONAL_DELIVERY\n## ═══════════════════════════════════════════════════════════════\n\n## Steps\npostingdate = PROF_SERVICE_DELIVERY.postingdate\neffectivedate = PROF_SERVICE_DELIVERY.postingdate\ndelivery_effdate = PROF_SERVICE_DELIVERY.effectivedate\nsubinstrumentid = PROF_SERVICE_DELIVERY.subinstrumentid\nthis_sub = PROF_SERVICE_DELIVERY.subinstrumentid\nunits = PROF_SERVICE_DELIVERY.units_delivered\nconcat_key = concat(instrumentid, this_sub)\npdel_ids = collect_by_instrument('PROF_SERVICE_DELIVERY_service_delivery_id')\npdel_subids = collect_by_instrument('PROF_SERVICE_DELIVERY_subinstrumentid')\npdel_units = collect_by_instrument('PROF_SERVICE_DELIVERY_units_delivered')\npdel_postings = collect_by_instrument('PROF_SERVICE_DELIVERY_postingdate')\npdel_effdates = collect_by_instrument('PROF_SERVICE_DELIVERY_effectivedate')\nline_ends = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_SERVICE_END_DATE_CURRENT')\norder_end = max(line_ends)\nregister_balance = collect_by_instrument(REVENUE_BALANCE.BALANCES_ENDINGBALANCE_TOTAL_REVENUE)\nbal_subids = collect_by_instrument('REVENUE_BALANCE_subinstrumentid')\nbal_amounts = collect_by_instrument('REVENUE_BALANCE_BALANCES_ENDINGBALANCE_TOTAL_REVENUE')\nregister_ssp = collect_all(SSP_RULE.ssp_amount)\nregister_so = collect_by_instrument(SALE_ORDER_DETAILS.ATTRIBUTE_SALE_PRICE_CURRENT)\ncat_product = collect_all('SSP_RULE_product_code')\ncat_policy = collect_all('SSP_RULE_standalone_price_policy')\ncat_ssp_amount = collect_all('SSP_RULE_ssp_amount')\nline_products = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_PRODUCT_ID_CURRENT')\nline_sub_ids = collect_by_instrument('SALE_ORDER_DETAILS_subinstrumentid')\nline_sale_prices = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_SALE_PRICE_CURRENT')\nline_postings = collect_by_instrument('SALE_ORDER_DETAILS_postingdate')\nboarding_month_end = end_of_month(array_get(line_postings, 0, postingdate))\n## Iteration\nline_policies = apply_each(line_products, \"lookup(cat_policy, cat_product, each)\", {\"cat_product\": cat_product, \"cat_policy\": cat_policy, \"line_products\": line_products})\n\n## Iteration\nline_ssp_dollar = apply_each(line_products, \"lookup(cat_ssp_amount, cat_product, each)\", {\"cat_product\": cat_product, \"cat_ssp_amount\": cat_ssp_amount, \"line_products\": line_products})\n\n## Iteration\nline_ssp_amounts = apply_each(line_products, \"if(eq(lookup(line_policies, line_products, each), \\\"DOLLAR_AMOUNT\\\"), lookup(line_ssp_dollar, line_products, each), lookup(line_sale_prices, line_products, each))\", {\"line_products\": line_products, \"line_sale_prices\": line_sale_prices, \"line_policies\": line_policies, \"line_ssp_dollar\": line_ssp_dollar})\n\nline_inv = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_INVOICE_NUMBER_CURRENT')\nline_refinv = collect_by_instrument('SALE_ORDER_DETAILS_ATTRIBUTE_REFERENCE_INVOICE_NUMBER_CURRENT')\n## Iteration\nline_is_credit = apply_each(line_sub_ids, \"if(neq(lookup(line_inv, line_sub_ids, each), lookup(line_refinv, line_sub_ids, each)), 1, 0)\", {\"line_sub_ids\": line_sub_ids, \"line_inv\": line_inv, \"line_refinv\": line_refinv})\n\n## Iteration\nline_sale_price_nc = apply_each(line_sub_ids, \"multiply(lookup(line_sale_prices, line_sub_ids, each), subtract(1, lookup(line_is_credit, line_sub_ids, each)))\", {\"line_sub_ids\": line_sub_ids, \"line_sale_prices\": line_sale_prices, \"line_is_credit\": line_is_credit})\n\n## Iteration\nline_ssp_nc = apply_each(line_sub_ids, \"multiply(lookup(line_ssp_amounts, line_sub_ids, each), subtract(1, lookup(line_is_credit, line_sub_ids, each)))\", {\"line_sub_ids\": line_sub_ids, \"line_ssp_amounts\": line_ssp_amounts, \"line_is_credit\": line_is_credit})\n\ntotal_sale_price = sum(line_sale_price_nc)\ntotal_ssp = sum(line_ssp_nc)\n## Iteration\nline_ratios = apply_each(line_sub_ids, \"if(eq(total_ssp, 0), 0, divide(lookup(line_ssp_amounts, line_sub_ids, each), total_ssp))\", {\"line_sub_ids\": line_sub_ids, \"line_ssp_amounts\": line_ssp_amounts, \"total_ssp\": total_ssp})\n\n## Iteration\nsub_recip = apply_each(line_sub_ids, \"divide(1, sum(eq(line_sub_ids, each)))\", {\"line_sub_ids\": line_sub_ids})\n\ndistinct_prod_count = sum(sub_recip)\n## Iteration\nline_base_alloc = apply_each(line_sub_ids, \"round(multiply(lookup(line_ratios, line_sub_ids, each), total_sale_price), 4)\", {\"line_sub_ids\": line_sub_ids, \"total_sale_price\": total_sale_price, \"line_ratios\": line_ratios})\n\n## Iteration\nline_base_alloc_adj = apply_each(line_sub_ids, \"if(gt(multiply(multiply(eq(total_ssp, 0), eq(distinct_prod_count, 1)), eq(lookup(line_ssp_amounts, line_sub_ids, each), 0)), 0), lookup(line_sale_prices, line_sub_ids, each), lookup(line_base_alloc, line_sub_ids, each))\", {\"line_sub_ids\": line_sub_ids, \"line_sale_prices\": line_sale_prices, \"line_ssp_amounts\": line_ssp_amounts, \"total_ssp\": total_ssp, \"distinct_prod_count\": distinct_prod_count, \"line_base_alloc\": line_base_alloc})\n\n## Iteration\nnoncredit_product_key = apply_each(line_sub_ids, \"if(eq(lookup(line_is_credit, line_sub_ids, each), 1), \\\"__CREDIT__\\\", lookup(line_products, line_sub_ids, each))\", {\"line_products\": line_products, \"line_sub_ids\": line_sub_ids, \"line_is_credit\": line_is_credit})\n\n## Iteration\nline_allocated = apply_each(line_sub_ids, \"if(eq(lookup(line_is_credit, line_sub_ids, each), 1), subtract(0, lookup(line_base_alloc_adj, noncredit_product_key, lookup(line_products, line_sub_ids, each))), lookup(line_base_alloc_adj, line_sub_ids, each))\", {\"line_products\": line_products, \"line_sub_ids\": line_sub_ids, \"line_is_credit\": line_is_credit, \"line_base_alloc_adj\": line_base_alloc_adj, \"noncredit_product_key\": noncredit_product_key})\n\nallocated_for_line = lookup(line_allocated, line_sub_ids, this_sub)\ndelivery_amount = round(multiply(units, allocated_for_line), 4)\ndelivery_ppa = if(gt(date_diff_days(end_of_month(delivery_effdate), end_of_month(postingdate)), 0), delivery_amount, 0)\ndelivery_revenue = if(lte(date_diff_days(end_of_month(delivery_effdate), end_of_month(postingdate)), 0), delivery_amount, 0)\n## Iteration\npdel_days = apply_each(pdel_ids, \"date_diff_days(lookup(pdel_postings, pdel_ids, each), postingdate)\", {\"postingdate\": postingdate, \"pdel_ids\": pdel_ids, \"pdel_postings\": pdel_postings})\n\n## Iteration\npdel_term_days = apply_each(pdel_ids, \"date_diff_days(lookup(pdel_postings, pdel_ids, each), lookup(line_ends, line_sub_ids, lookup(pdel_subids, pdel_ids, each)))\", {\"pdel_ids\": pdel_ids, \"pdel_subids\": pdel_subids, \"pdel_postings\": pdel_postings, \"line_ends\": line_ends, \"line_sub_ids\": line_sub_ids})\n\n## Iteration\ndel_cum_incl = apply_each(pdel_ids, \"sum(multiply(multiply(multiply(eq(pdel_subids, lookup(pdel_subids, pdel_ids, each)), gte(pdel_term_days, 0)), gte(pdel_days, 0)), pdel_units))\", {\"pdel_ids\": pdel_ids, \"pdel_subids\": pdel_subids, \"pdel_units\": pdel_units, \"pdel_days\": pdel_days, \"pdel_term_days\": pdel_term_days})\n\n## Iteration\ndel_cum_prior = apply_each(pdel_ids, \"sum(multiply(multiply(multiply(eq(pdel_subids, lookup(pdel_subids, pdel_ids, each)), gte(pdel_term_days, 0)), gt(pdel_days, 0)), pdel_units))\", {\"pdel_ids\": pdel_ids, \"pdel_subids\": pdel_subids, \"pdel_units\": pdel_units, \"pdel_days\": pdel_days, \"pdel_term_days\": pdel_term_days})\n\n## Iteration\ndel_n_logs = apply_each(pdel_ids, \"if(lt(sum(multiply(multiply(eq(pdel_subids, lookup(pdel_subids, pdel_ids, each)), gte(pdel_term_days, 0)), eq(pdel_days, 0))), 1), 1, sum(multiply(multiply(eq(pdel_subids, lookup(pdel_subids, pdel_ids, each)), gte(pdel_term_days, 0)), eq(pdel_days, 0))))\", {\"pdel_ids\": pdel_ids, \"pdel_subids\": pdel_subids, \"pdel_days\": pdel_days, \"pdel_term_days\": pdel_term_days})\n\n## Iteration\ndel_amount = apply_each(pdel_ids, \"round(multiply(if(gt(multiply(lookup(pdel_units, pdel_ids, each), lookup(line_allocated, line_sub_ids, lookup(pdel_subids, pdel_ids, each))), if(lt(add(lookup(line_allocated, line_sub_ids, lookup(pdel_subids, pdel_ids, each)), sum(multiply(eq(bal_subids, lookup(pdel_subids, pdel_ids, each)), bal_amounts))), 0), 0, add(lookup(line_allocated, line_sub_ids, lookup(pdel_subids, pdel_ids, each)), sum(multiply(eq(bal_subids, lookup(pdel_subids, pdel_ids, each)), bal_amounts))))), if(lt(add(lookup(line_allocated, line_sub_ids, lookup(pdel_subids, pdel_ids, each)), sum(multiply(eq(bal_subids, lookup(pdel_subids, pdel_ids, each)), bal_amounts))), 0), 0, add(lookup(line_allocated, line_sub_ids, lookup(pdel_subids, pdel_ids, each)), sum(multiply(eq(bal_subids, lookup(pdel_subids, pdel_ids, each)), bal_amounts)))), multiply(lookup(pdel_units, pdel_ids, each), lookup(line_allocated, line_sub_ids, lookup(pdel_subids, pdel_ids, each)))), if(eq(lookup(pdel_postings, pdel_ids, each), postingdate), 1, 0)), 4)\", {\"postingdate\": postingdate, \"pdel_ids\": pdel_ids, \"pdel_subids\": pdel_subids, \"pdel_units\": pdel_units, \"pdel_postings\": pdel_postings, \"bal_subids\": bal_subids, \"bal_amounts\": bal_amounts, \"line_sub_ids\": line_sub_ids, \"line_allocated\": line_allocated})\n\n## Iteration\ndel_ispast = apply_each(pdel_ids, \"if(gt(date_diff_days(end_of_month(lookup(pdel_effdates, pdel_ids, each)), end_of_month(postingdate)), 0), 1, 0)\", {\"postingdate\": postingdate, \"pdel_ids\": pdel_ids, \"pdel_effdates\": pdel_effdates})\n\n## Iteration\ndel_subs = apply_each(pdel_ids, \"lookup(pdel_subids, pdel_ids, each)\", {\"pdel_ids\": pdel_ids, \"pdel_subids\": pdel_subids})\n\n## Iteration\ndel_ppa_neg = apply_each(pdel_ids, \"multiply(multiply(lookup(del_amount, pdel_ids, each), lookup(del_ispast, pdel_ids, each)), -1)\", {\"pdel_ids\": pdel_ids, \"del_amount\": del_amount, \"del_ispast\": del_ispast})\n\n## Iteration\ndel_rev_neg = apply_each(pdel_ids, \"multiply(multiply(lookup(del_amount, pdel_ids, each), subtract(1, lookup(del_ispast, pdel_ids, each))), -1)\", {\"pdel_ids\": pdel_ids, \"del_amount\": del_amount, \"del_ispast\": del_ispast})\n\ndel_amt_row = round(if(gt(multiply(units, allocated_for_line), if(lt(add(allocated_for_line, sum(multiply(eq(bal_subids, this_sub), bal_amounts))), 0), 0, add(allocated_for_line, sum(multiply(eq(bal_subids, this_sub), bal_amounts))))), if(lt(add(allocated_for_line, sum(multiply(eq(bal_subids, this_sub), bal_amounts))), 0), 0, add(allocated_for_line, sum(multiply(eq(bal_subids, this_sub), bal_amounts)))), multiply(units, allocated_for_line)), 4)\ndel_rev_row_neg = if(lte(date_diff_days(end_of_month(delivery_effdate), end_of_month(postingdate)), 0), multiply(del_amt_row, -1), 0)\ndel_ppa_row_neg = if(gt(date_diff_days(end_of_month(delivery_effdate), end_of_month(postingdate)), 0), multiply(del_amt_row, -1), 0)\n\n## Create Transactions\ncreateTransaction(postingdate, effectivedate, \"Revenue\", del_rev_neg, subinstrumentid)\ncreateTransaction(postingdate, effectivedate, \"Revenue_PPA\", del_ppa_neg, subinstrumentid)\n\n## ═══════════════════════════════════════════════════════════════\n## REVREC_BILLING\n## ═══════════════════════════════════════════════════════════════\n\n## Steps\npostingdate = BILLING_SCHEDULE.postingdate\neffectivedate = BILLING_SCHEDULE.effectivedate\nsubinstrumentid = collect_by_instrument(BILLING_SCHEDULE.subinstrumentid)\nbilling_amount = collect_by_instrument('BILLING_SCHEDULE_billing_amount')\n\n## Create Transactions\ncreateTransaction(postingdate, effectivedate, \"NEW_BILLING\", billing_amount, subinstrumentid)",
