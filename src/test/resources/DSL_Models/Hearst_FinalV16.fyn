              "periodCount": "12",
              "periodCountSource": "value",
              "periodCountField": "",
              "periodCountFormula": "",
              "frequency": "M",
              "convention": "",
              "columns": [
                {
                  "name": "period_date",
                  "formula": "period_date"
                },
                {
                  "formula": "end_of_month(period_date)",
                  "name": "month_end"
                },
                {
                  "formula": "add(date_diff_days(if(gt(date_diff_days(start_of_month(month_end), line_starts), 0), line_starts, start_of_month(month_end)), if(gt(date_diff_days(line_ends, month_end), 0), line_ends, month_end)), 1)",
                  "name": "days_in_month",
                  "commentText": "days of service falling in this month - prorated for mid-month start or end"
                },
                {
                  "formula": "add(period_index, 1)",
                  "name": "period_no"
                },
                {
                  "formula": "date_diff_days(line_starts, start_of_month(month_end))",
                  "name": "prior_ltd_days"
                },
                {
                  "formula": "if(eq(date_diff_days(month_end, end_of_month(line_ends)), 0), 1, 0)",
                  "name": "is_last"
                },
                {
                  "formula": "if(eq(line_is_ratable, 1), multiply(line_per_day, days_in_month), if(eq(line_is_pit, 1), if(eq(date_diff_days(month_end, end_of_month(line_starts)), 0), line_allocated, 0), if(eq(line_is_prop, 1), if(eq(is_last, 1), line_remaining, 0), if(eq(is_last, 1), line_allocated, 0))))",
                  "name": "gross_calc",
                  "commentText": "RATABLE = per-day x days of service in this month (no duration column). POINT_IN_TIME = full amount in the month containing service start. PROPORTIONAL = remaining balance at service end."
                },
                {
                  "formula": "lag('ltd_gross', 1, 0)",
                  "name": "cum_prior"
                },
                {
                  "formula": "if(eq(multiply(is_last, line_is_ratable), 1), subtract(line_allocated, cum_prior), gross_calc)",
                  "name": "gross_revenue"
                },
                {
                  "formula": "end_of_month(boarding_month_end)",
                  "name": "boarding_me"
                },
                {
                  "formula": "if(gt(date_diff_days(month_end, boarding_me), 0), gross_revenue, 0)",
                  "name": "pre_gross"
                },
                {
                  "formula": "add(lag('cum_pre', 1, 0), pre_gross)",
                  "name": "cum_pre"
                },
                {
                  "formula": "round(if(eq(date_diff_days(month_end, boarding_me), 0), lag('cum_pre', 1, 0), 0), 4)",
                  "name": "revenue_ppa"
                },
                {
                  "formula": "if(lte(date_diff_days(month_end, boarding_me), 0), gross_revenue, 0)",
                  "name": "revenue"
                },
                {
                  "formula": "add(lag('ltd_gross', 1, 0), gross_revenue)",
                  "name": "ltd_gross"
                }
              ],
              "outputs": [
                {
